CLEANUP = r"""
cd "$REPO" 2>/dev/null || { echo "missing=1"; exit 0; }
git rev-parse --git-dir >/dev/null 2>&1 || { echo "missing=1"; exit 0; }
git fetch --prune --quiet "$REMOTE" 2>/dev/null
base=$(git symbolic-ref --quiet --short "refs/remotes/$REMOTE/HEAD" 2>/dev/null)
[ -n "$base" ] || base=$(git rev-parse --abbrev-ref HEAD)
echo "base=$base"
git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch refs\/heads\/drover\//{sub("refs/heads/","",$2); print "worktree=" $2 "=" w}'
for b in $(git for-each-ref --format='%(refname:short)' "refs/heads/$PREFIX*"); do
  if git merge-base --is-ancestor "$b" "$base" 2>/dev/null; then m=1
  elif [ -z "$(git cherry "$base" "$b" 2>/dev/null | grep '^+')" ]; then m=1
  else m=0; fi
  echo "local=$b=$m=$(git log -1 --format=%cr "$b")"
done
for b in $(git for-each-ref --format='%(refname:short)' "refs/remotes/$REMOTE/$PREFIX*"); do
  short=${b#$REMOTE/}
  if git merge-base --is-ancestor "$b" "$base" 2>/dev/null; then m=1
  elif [ -z "$(git cherry "$base" "$b" 2>/dev/null | grep '^+')" ]; then m=1
  else m=0; fi
  echo "remote=$short=$m"
done
"""


def cleanup_plan(cfg, repo, machine):
    remote = cfg["handoff"].get("remote", "origin")
    path = remote_path(cfg, repo, machine)
    env = f"REPO={shlex.quote(path)} REMOTE={shlex.quote(remote)} PREFIX={shlex.quote(BRANCH_PREFIX)}\n"
    code, out, err = remote_sh(hc_target(machine), env + CLEANUP, timeout=90)
    plan = {"machine": machine, "repo": path, "worktrees": {}, "local": [], "remote": [], "keep": []}
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k == "missing":
            plan["missing"] = True
        elif k == "base":
            plan["base"] = v
        elif k == "worktree":
            b, w = v.split("=", 1)
            plan["worktrees"][b] = w
        elif k == "local":
            b, m, age = v.split("=", 2)
            (plan["local"] if m == "1" else plan["keep"]).append({"branch": b, "age": age})
        elif k == "remote":
            b, m = v.split("=", 1)
            if m == "1":
                plan["remote"].append({"branch": b})
            elif not any(x["branch"] == b for x in plan["keep"]):
                plan["keep"].append({"branch": b, "age": "remote only"})
    busy = {labels(t).get("drover.branch") for t in drover_terminals()}
    for kind in ("local", "remote"):
        for x in list(plan[kind]):
            if x["branch"] in busy:  # an agent still works there
                plan[kind].remove(x)
                plan["keep"].append({"branch": x["branch"], "age": "agent still running"})
    return plan


def cleanup_apply(cfg, plan):
    remote = cfg["handoff"].get("remote", "origin")
    cmds = [f"cd {shlex.quote(plan['repo'])} || exit 1"]
    for x in plan["local"]:
        w = plan["worktrees"].get(x["branch"])
        if w:
            cmds.append(f"git worktree remove --force {shlex.quote(w)}")
        # -D is safe here: the plan only lists branches whose changes are in base.
        cmds.append(f"git branch -D {shlex.quote(x['branch'])}")
    if cfg["cleanup"].get("delete_remote"):
        for x in plan["remote"]:
            cmds.append(f"git push --quiet {shlex.quote(remote)} --delete {shlex.quote(x['branch'])}")
    cmds.append("git worktree prune")
    code, out, err = remote_sh(hc_target(plan["machine"]), "\n".join(cmds) + "\necho done=1", timeout=120)
    return "done=1" in out, out + err


