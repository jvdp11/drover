def cmd_config(a, cfg):
    if a.set_json:
        try:
            new = json.loads(a.set_json)
        except json.JSONDecodeError as e:
            die(f"not JSON: {e}")
        if not isinstance(new, dict) or not isinstance(new.get("roles", {}), dict):
            die("settings must be a JSON object")
        write_json(CONFIG, new)
        cfg = load_config()
    elif a.init and not os.path.exists(CONFIG):
        write_json(CONFIG, {"version": 1, "machines": {}})
        cfg = load_config()
    emit({"path": CONFIG, "config": cfg}, a.json, lambda d: json.dumps(d["config"], indent=2))


def fmt_machine(m):
    if not m.get("online"):
        return f"  {m['name']:<14} offline  {m.get('error', '')}"
    return (f"  {m['name']:<14} {m.get('os', ''):<7} {m.get('cpus') or '?':>3} cpu  load {m.get('load')}  "
            f"{m.get('disk_free_gb')} GB free  {m.get('power')}  {' '.join(m.get('tools', []))}")


def cmd_probe(a, cfg):
    data = probe(cfg)
    emit(data, a.json, lambda d: "\n".join(fmt_machine(m) for m in d["machines"]))


def cmd_status(a, cfg):
    data = fleet(cfg, max_age=a.max_age)
    for m in data["machines"]:
        m["settings"] = machine_cfg(cfg, m["name"])
    agents = []
    for t in drover_terminals():
        lb = labels(t)
        agents.append({"address": t["address"], "machine": machine_of(t["address"]),
                       "role": lb.get("drover.role"), "agent": lb.get("drover.agent"),
                       "model": lb.get("drover.model") or None, "task": lb.get("drover.task"),
                       "branch": lb.get("drover.branch"), "status": t.get("status"), "state": t.get("state")})
    out = {"version": VERSION, "local": local_name(), "updated": data["updated"],
           "machines": data["machines"], "agents": agents, "roles": list(cfg["roles"]), "config": cfg}
    emit(out, a.json, lambda d: "\n".join(fmt_machine(m) for m in d["machines"]) +
         "".join(f"\n  {x['address']:<16} {x['role']:<12} {x['agent']} {x['task'] or ''}" for x in d["agents"]))


def fmt_route(d):
    lines = [f"{d['role']}: " + (f"{d['agent']}{' (' + d['model'] + ')' if d.get('model') else ''} on {d['machine']}"
                                 if d["agent"] else "nowhere to run it")]
    for x in d["rejected"]:
        lines.append(f"  skipped {x.get('agent') or ''}{' on ' if x.get('agent') and x.get('machine') else ''}"
                     f"{x.get('machine') or ''}: {x['why']}")
    return "\n".join(lines)


def cmd_route(a, cfg):
    d = route(cfg, a.role, families_to_avoid=a.avoid_family or (), machine=a.machine)
    emit(d, a.json, fmt_route)
    sys.exit(0 if d["agent"] else 3)


PRETRUST_CONFIGS = {"codex": (".codex/config.toml", True),
                   "claude": (".claude.json", False),
                   # cursor-agent records trust as ~/.cursor/projects/<slug>/.workspace-trusted
                   # ({"trustedAt", "workspacePath"}), written when "Trust this workspace"
                   # is accepted; with it present no prompt appears (verified). It also has
                   # a `--trust` flag, but an unknown flag would break older installs on
                   # remote hosts, so drover writes the marker instead (see cursor()).
                   "cursor": (".cursor/projects", True)}


def pretrust_config(agent, paths, relative, create):
    """Self-contained so the same stdlib-only code can run on the target host."""
    import fcntl
    import hashlib
    import json
    import os
    import re
    import stat
    import subprocess
    import tempfile
    import time

    def codex(text, roots):
        # Mask strings/comments before finding table boundaries: a prompt in a
        # multiline TOML string can itself contain apparent project tables.
        quoted = r'"(?:\\.|[^"\\\r\n])*"|\'[^\'\r\n]*\''
        token = quoted + r'|[A-Za-z0-9_-]+'
        strings = r'#[^\r\n]*|"""(?:\\[\s\S]|(?!""")[\s\S])*"""'
        strings += r"|'''[\s\S]*?'''|" + quoted

        def key(value):
            if value.startswith("'"):
                return value[1:-1]
            if value.startswith('"'):
                # TOML basic keys share JSON escapes, plus \UXXXXXXXX.
                return json.loads(re.sub(r'\\(U[0-9A-Fa-f]{8}|.)',
                    lambda m: json.dumps(chr(int(m[1][1:], 16)))[1:-1]
                    if m[1].startswith("U") else m[0], value))
            return value

        for root in roots:
            masked = re.sub(strings, lambda m: re.sub(r'[^\r\n]', ' ', m[0]), text)
            headers = list(re.finditer(r'(?m)^[ \t]*\[', masked))
            found = False
            for i, header in enumerate(headers):
                end = text.find("\n", header.start())
                end = len(text) if end < 0 else end + 1
                match = re.fullmatch(r'\s*\[\s*((?:' + token + r')(?:\s*\.\s*(?:' + token +
                                    r'))*)\s*\]\s*(?:#[^\r\n]*)?\s*', text[header.start():end])
                if not match or [key(m[0]) for m in re.finditer(token, match[1])] != ["projects", root]:
                    continue
                found = True
                stop = headers[i + 1].start() if i + 1 < len(headers) else len(text)
                body = text[end:stop]
                # Only inspect actual assignment lines, not multiline strings.
                assignments = re.finditer(r'(?m)^[ \t]*(?:trust_level|"trust_level"|\'trust_level\')'
                                          r'[ \t]*=[ \t]*(?P<value>"[^"\r\n]*"|\'[^\'\r\n]*\')', body)
                for assignment in assignments:
                    equals = end + body.index("=", assignment.start(), assignment.end())
                    if masked[equals] != "=":
                        continue
                    a, b = assignment.span("value")
                    if key(body[a:b]) != "trusted":
                        text = text[:end + a] + '"trusted"' + text[end + b:]
                    break
                else:
                    text = text[:end] + ("" if text[:end].endswith("\n") else "\n") + \
                           'trust_level = "trusted"\n' + text[end:]
                break
            if not found:
                if text:
                    text += "\n" if text.endswith("\n") else "\n\n"
                text += '[projects.' + json.dumps(root, ensure_ascii=False) + ']\ntrust_level = "trusted"\n'
        # Validate when available without requiring Python newer than 3.9.
        try:
            import tomllib
        except ImportError:
            pass
        else:
            parsed = tomllib.loads(text)
            if any(parsed["projects"][root]["trust_level"] != "trusted" for root in roots):
                raise ValueError("could not locate Codex project trust tables")
        return text

    def claude(text, roots):
        data = json.loads(text)
        changed = False
        for root in roots:
            project = data.setdefault("projects", {}).setdefault(root, {})
            if project.get("hasTrustDialogAccepted") is not True:
                project["hasTrustDialogAccepted"] = True
                changed = True
        return json.dumps(data, indent=2) + "\n" if changed else text

    def cursor(text, roots):
        # One file per workspace, so `roots` holds exactly one folder here.
        # Content is {"trustedAt": ISO-8601 UTC, "workspacePath": folder}.
        try:
            data = json.loads(text) if text.strip() else {}
        except ValueError:
            data = {}
        if isinstance(data, dict) and data.get("trustedAt") and data.get("workspacePath") == roots[0]:
            return text
        data = dict(data) if isinstance(data, dict) else {}
        stamp = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime())
        data.setdefault("trustedAt", stamp + ".000Z")
        data["workspacePath"] = roots[0]
        return json.dumps(data, indent=2) + "\n"

    edit = {"codex": codex, "claude": claude, "cursor": cursor}[agent]
    roots = []
    for folder in paths:
        folder = os.path.abspath(os.path.expanduser(folder))
        result = subprocess.run(["git", "-C", folder, "rev-parse", "--show-toplevel"],
                                capture_output=True, text=True, timeout=5)
        root = result.stdout.strip() if result.returncode == 0 else folder
        if root not in roots:
            roots.append(root)
    if agent == "cursor":
        # cursor-agent keeps ~/.cursor/projects/<slug>/.workspace-trusted per
        # workspace; slug = path with every run of non-alphanumerics -> "-".
        base = os.path.realpath(os.path.expanduser("~/" + relative))
        targets = [(os.path.join(base, re.sub(r"[^A-Za-z0-9]+", "-", root).strip("-"),
                                 ".workspace-trusted"), [root]) for root in roots]
        lock_key = base
    else:
        path = os.path.realpath(os.path.expanduser("~/" + relative))
        if not create and not os.path.exists(path):
            return
        targets = [(path, roots)]
        lock_key = path
    # Keep a stable lock inode across config replacements and waiting writers.
    # Unlinking it after use would let concurrent writers lock different inodes.
    lock_dir = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                            "drover", "locks")
    os.makedirs(lock_dir, exist_ok=True)
    lock_path = os.path.join(lock_dir, "pretrust-" + hashlib.sha256(lock_key.encode()).hexdigest() + ".lock")
    with open(lock_path, "a") as lock:
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("timed out locking " + lock_key)
                time.sleep(0.05)
        for path, file_roots in targets:
            try:
                with open(path, encoding="utf-8", newline="") as source:
                    before = source.read()
                mode = stat.S_IMODE(os.stat(path).st_mode)
            except FileNotFoundError:
                if not create:
                    continue
                before, mode = "", (0o644 if agent == "cursor" else 0o600)
            after = edit(before, file_roots)
            if after == before:
                continue
            os.makedirs(os.path.dirname(path), exist_ok=True)
            fd, temporary = tempfile.mkstemp(prefix=".drover-pretrust-", dir=os.path.dirname(path))
            try:
                with os.fdopen(fd, "w", encoding="utf-8", newline="") as output:
                    os.fchmod(output.fileno(), mode)
                    output.write(after)
                os.replace(temporary, path)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)


def pretrust_agent(cfg, agent, machine, repo, cwd):
    """Trust on the execution host; configuration errors must never stop a launch."""
    try:
        if agent not in PRETRUST_CONFIGS or not cfg["agents"][agent].get("pretrust", True):
            return
        arguments = (agent, [repo, cwd], *PRETRUST_CONFIGS[agent])
        if hc_target(machine) is None:
            pretrust_config(*arguments)
        else:
            source = inspect.getsource(pretrust_config)
            source += "\npretrust_config(*" + repr(arguments) + ")\n"
            code, out, err = remote_sh(hc_target(machine),
                                      "python3 -c " + shlex.quote(source) + " 2>&1", timeout=30)
            if code:
                raise RuntimeError((out + err).strip() or f"exit {code}")
    except Exception as e:
        print(f"drover: warning: could not pre-trust {agent} folders on {machine}: {e}", file=sys.stderr)


def start_agent(cfg, role, repo, message, title, *, avoid=(), machine=None, labels_extra=None,
                cwd=None, branch=None, worktree=True, dry_run=False, name=None, auto=False,
                prefer_agent=None, prefer_model=None, prefer_force=False, skip_agent=None):
    """Route a role and start it in a kept hc terminal. Unless `cwd` is given,
    every role but the coordinator gets its own drover/<task> branch in its own
    worktree on that machine, so parallel agents never share a checkout
    (Herdr's worktree folder, so the app nests it under the repo).
    Returns the routing decision plus what was started; dies when nowhere fits."""
    d = route(cfg, role, families_to_avoid=avoid, machine=machine, repo=None if cwd else repo,
              prefer_agent=prefer_agent, prefer_model=prefer_model, prefer_force=prefer_force, skip_agent=skip_agent)
    if not d["agent"]:
        return d
    agent = cfg["agents"][d["agent"]]
    rpath = remote_path(cfg, repo, d["machine"])
    stamp = time.strftime("%m%d%H%M")
    name = name or f"{role[:4]}-{slug(title, 14)}-{stamp[-4:]}"
    if cwd is None and worktree and role != "coordinator":
        branch = branch or f"{BRANCH_PREFIX}{slug(title)}-{stamp}"
        wt_home = next((m.get("home") for m in fleet(cfg)["machines"] if m["name"] == d["machine"]), None) or HOME
        cwd = f"{wt_home}/.herdr/worktrees/{os.path.basename(rpath.rstrip('/'))}/{branch.replace('/', '-')}"
        new_worktree = True
    else:
        new_worktree = False
        cwd = cwd or rpath
    argv = build_argv(agent, d.get("model"), message, rpath, auto=auto)
    lb = {"drover.role": role, "drover.agent": d["agent"], "drover.model": d.get("model") or "",
          "drover.task": title[:120], "drover.branch": branch or "", "drover.family": agent["family"],
          **(labels_extra or {})}
    args = ["run", "--bg", "--json", *on_args(hc_target(d["machine"])), "--cwd", cwd, "--name", name, "--keep"]
    for k, v in lb.items():
        args += ["--label", f"{k}={v}"]
    if not os.environ.get("HC_TERMINAL_ID"):
        args.append("--no-parent")
    args += ["--", *argv]
    d.update({"argv": argv, "cwd": cwd, "branch": branch or "", "repo": rpath, "name": name})
    if dry_run:
        d["hc"] = ["hc", *args]
        return d
    if new_worktree:
        script = (f"cd {shlex.quote(rpath)} || exit 1\n"
                  f"git rev-parse --git-dir >/dev/null 2>&1 || {{ echo 'error=not a git repo'; exit 0; }}\n"
                  f"mkdir -p {shlex.quote(os.path.dirname(cwd))}\n"
                  f"git worktree add --quiet -b {shlex.quote(branch)} {shlex.quote(cwd)} HEAD 2>&1 && echo ok=1\n")
        code, out, err = remote_sh(hc_target(d["machine"]), script, timeout=60)
        if "ok=1" not in out:
            die(f"could not make worktree {cwd} on {d['machine']}: {(out + err).strip() or 'repo missing there?'}")
    pretrust_agent(cfg, d["agent"], d["machine"], rpath, cwd)
    code, out, err = hc(args, timeout=90)
    if code != 0:
        die(f"hc run failed: {err.strip() or out.strip()}")
    started = json.loads(out) if out.strip().startswith("{") else {}
    d["started"] = started
    d["address"] = started.get("address") or started.get("terminal", {}).get("address") or ""
    if d["address"] and "/" not in d["address"] and d["machine"] != local_name():
        d["address"] = f"{d['machine']}/{d['address']}"
    return d


def cmd_run(a, cfg):
    d = start_agent(cfg, a.role, a.repo, a.task, a.task, avoid=a.avoid_family or (), machine=a.machine,
                    dry_run=a.dry_run, name=a.name)
    if not d["agent"]:
        emit(d, a.json, fmt_route)
        sys.exit(3)
    if a.dry_run:
        emit(d, a.json, lambda x: fmt_route(x) + "\n  would run: " + shlex.join(x["hc"]))
        return
    emit(d, a.json, lambda x: fmt_route(x) + f"\n  started {x['address']}")


def cmd_cleanup(a, cfg):
    machines = [m["name"] for m in fleet(cfg)["machines"] if m.get("online")]
    if a.machine:
        machines = [a.machine]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        plans = [p for p in pool.map(lambda m: cleanup_plan(cfg, a.repo, m), machines) if not p.get("missing")]
    # The remote is shared: delete each remote branch once.
    seen = set()
    for p in plans:
        p["remote"] = [x for x in p["remote"] if x["branch"] not in seen and not seen.add(x["branch"])]
    if a.yes:
        for p in plans:
            if p["local"] or p["remote"]:
                p["applied"], p["log"] = cleanup_apply(cfg, p)

    def text(ps):
        lines = []
        for p in ps:
            lines.append(f"{p['machine']}: {p['repo']} (base {p.get('base', '?')})")
            for x in p["local"]:
                wt = p["worktrees"].get(x["branch"])
                lines.append(f"  {'removed' if p.get('applied') else 'remove'} {x['branch']}" + (f" + worktree {wt}" if wt else ""))
            for x in p["remote"]:
                lines.append(f"  {'removed' if p.get('applied') else 'remove'} remote {x['branch']}")
            for x in p["keep"]:
                lines.append(f"  keep   {x['branch']} (not merged; {x['age']})")
            if not (p["local"] or p["remote"] or p["keep"]):
                lines.append("  nothing to clean")
        if not a.yes and any(p["local"] or p["remote"] for p in ps):
            lines.append("dry run: add --yes to remove the branches above")
        return "\n".join(lines) or "the repo is on no reachable machine"
    emit({"plans": plans, "applied": a.yes}, a.json, text)


