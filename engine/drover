RANGE_RE = re.compile(r"^(.*):(\d+)(?:-(\d+))?$")


def parse_files(spec):
    """'a/b.py:10-20,c.py' -> [{'path','start','end'}, ...]; start/end are None without a range."""
    out = []
    for part in (spec or "").split(","):
        part = part.strip()
        if not part:
            continue
        m_ = RANGE_RE.match(part)
        if m_:
            start, end = int(m_.group(2)), int(m_.group(3) or m_.group(2))
            if end < start:
                start, end = end, start
            out.append({"path": m_.group(1).strip(), "start": start, "end": end})
        else:
            out.append({"path": part, "start": None, "end": None})
    return out


def check_files(repo, files):
    """Warnings (never errors) for missing files and ranges past the end of a file."""
    warnings = []
    for f in files:
        full = os.path.join(repo, f["path"])
        if not os.path.exists(full):
            warnings.append(f"--files: {f['path']} does not exist in {repo}")
        elif f["start"] and os.path.isfile(full):
            try:
                with open(full, "rb") as fh:
                    n = sum(1 for _ in fh)
            except OSError:
                continue
            if f["start"] > n or f["end"] > n:
                warnings.append(f"--files: {f['path']}:{f['start']}-{f['end']} is past the end of the file ({n} lines)")
    return warnings


def fmt_file(f):
    if not f.get("start"):
        return f["path"]
    return f"{f['path']} (lines {f['start']}-{f['end']})" if f["end"] != f["start"] else f"{f['path']} (line {f['start']})"


def render_brief(t):
    """The worker-facing text: Read first, Done when, size, then the free-text brief."""
    parts = []
    if t.get("files"):
        parts.append("Read first (only what is needed beyond these; don't explore the rest):\n"
                     + "\n".join(f"- {fmt_file(f)}" for f in t["files"]))
    if t.get("done"):
        parts.append("Done when:\n" + "\n".join(f"- {d_}" for d_ in t["done"]))
    if t.get("size"):
        parts.append(f"Size: {t['size']} (keep the change this small; if it grows, tell the coordinator so it can be split)")
    if parts:
        parts.append("Brief:\n" + t["brief"])
    else:
        return t["brief"]
    return "\n\n".join(parts)


def worker_msg(mid, t, branch):
    return WORKER_BRIEF.format(tid=t["id"], mid=mid, title=t["title"], branch=branch, brief=render_brief(t),
                              ui=UI_WORKER if touches_mods(t) else "")


def reviewer_msg(data, t):
    done = ("\nDone when (check each one):\n" + "\n".join(f"- {d_}" for d_ in t["done"]) + "\n") if t.get("done") else ""
    return REVIEWER_BRIEF.format(tid=t["id"], mid=data["id"], title=t["title"], branch=t["branch"],
                                 base=data["base"], brief=t["brief"], done=done,
                                 ui=UI_REVIEWER if touches_mods(t) else "")


class Mission:
    """mission.json plus log.jsonl, updated under a lock."""

    def __init__(self, mid):
        self.dir = os.path.join(MISSIONS, mid)
        self.path = os.path.join(self.dir, "mission.json")
        if not os.path.exists(self.path):
            die(f"no mission {mid}")

    def read(self):
        with open(self.path) as f:
            return json.load(f)

    def update(self, fn):
        import fcntl
        with open(os.path.join(self.dir, ".lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = self.read()
            out = fn(data)
            data["updated"] = int(time.time())
            write_json(self.path, data)
            return out

    def log(self, kind, frm, to, text, **extra):
        entry = {"at": int(time.time()), "kind": kind, "from": frm, "to": to, "text": text, **extra}
        with open(os.path.join(self.dir, "log.jsonl"), "a") as f:
            f.write(json.dumps(entry) + "\n")
        return entry

    def entries(self, limit=200):
        try:
            with open(os.path.join(self.dir, "log.jsonl")) as f:
                lines = f.readlines()
        except FileNotFoundError:
            return []
        entries = []
        for line in lines:
            try:
                entry = json.loads(line)
                if isinstance(entry, dict):
                    entries.append(entry)
            except json.JSONDecodeError:  # a concurrent writer may not have finished its line
                continue
        return entries if limit is None else entries[-limit:] if limit else []


def mission_archived(data, cfg):
    if data.get("archived"):
        return True
    if data.get("state") != "done":
        return False
    since = max(data.get("done_at") or data.get("updated") or data.get("created") or 0,
                data.get("unarchived_at") or 0)
    return time.time() - since > cfg["missions"]["archive_after_days"] * 86400


def mission_rows(repo=None, cfg=None):
    """Shared mission listing, newest first; ignore incomplete mission files."""
    cfg = cfg or load_config()
    rows = []
    for mid in sorted(os.listdir(MISSIONS), reverse=True) if os.path.isdir(MISSIONS) else []:
        if not os.path.isfile(os.path.join(MISSIONS, mid, "mission.json")):
            continue
        try:
            x = Mission(mid).read()
            if repo is not None and os.path.realpath(x["repo"]) != os.path.realpath(repo):
                continue
            tasks = x.get("tasks", {})
            rows.append({k: x.get(k) for k in ("id", "goal", "project", "repo", "state", "created", "created_ns", "updated", "summary")}
                        | {"archived": mission_archived(x, cfg), "tasks": len(tasks), "merged": sum(t.get("state") == "merged" for t in tasks.values())})
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return sorted(rows, key=lambda r: (r.get("created_ns") or (r.get("created") or 0) * 10**9, r["id"]), reverse=True)


def me():
    """This terminal's drover labels (empty outside hc)."""
    tid = os.environ.get("HC_TERMINAL_ID")
    if not tid:
        return {}
    code, out, err = hc(["get", tid, "--json"])
    try:
        t = json.loads(out)
        t = t.get("terminal", t)
        return {**(t.get("labels") or {}), "_address": t.get("address", tid), "_cwd": t.get("cwd", "")}
    except (json.JSONDecodeError, AttributeError):
        return {}


def same_address(a, b):
    """Same terminal? An unqualified address belongs to this machine."""
    def full(x):
        return x if "/" in x else f"{local_name()}/{x}"
    return bool(a and b) and full(a) == full(b)


def running_missions(repo=None, coordinator=None):
    """Running missions (newest first), optionally of one repo or one coordinator address."""
    out = []
    for r in mission_rows(repo):
        if r["state"] != "running":
            continue
        m = Mission(r["id"])
        if coordinator and not same_address(m.read().get("coordinator", {}).get("address"), coordinator):
            continue
        out.append(m)
    return out


def current_mission(a_mission=None):
    if a_mission:
        return Mission(a_mission)
    lb = me()
    if lb.get("drover.role") == "coordinator":
        # A coordinator serves several missions: the newest running one is the default.
        mine = running_missions(lb.get("drover.repo") or lb.get("_cwd") or None, lb.get("_address"))
        if mine:
            return mine[0]
    mid = lb.get("drover.mission")
    if mid:
        return Mission(mid)
    ids = sorted(os.listdir(MISSIONS), reverse=True) if os.path.isdir(MISSIONS) else []
    if not ids:
        die("no missions yet: drover mission start --repo <folder> \"<goal>\"")
    return Mission(ids[0])


def find_coordinator(repo):
    """The live coordinator of this repo (any machine), as a mission's coordinator record, or None."""
    real = os.path.realpath(repo)
    known = {}
    for m in running_missions(repo):
        c = m.read().get("coordinator") or {}
        if c.get("address"):
            known.setdefault(c["address"], c)
    terminals = None
    for attempt in (1, 2):  # an inconclusive check is retried once, never read as "gone"
        try:
            terminals = drover_terminals(strict=True)
            break
        except Inconclusive as e:
            problem = e
    if terminals is None:
        die(f"could not check whether {tilde(repo)} already has a coordinator ({problem}); "
            "no mission was started and nothing was launched or adopted. Try again.")
    for t in terminals:
        lb = labels(t)
        if lb.get("drover.role") != "coordinator" or not t.get("address"):
            continue
        place = lb.get("drover.repo") or t.get("cwd") or ""
        if os.path.realpath(place) != real:
            continue
        rec = next((c for addr, c in known.items() if same_address(addr, t["address"])), None)
        return rec or {"address": t["address"], "agent": lb.get("drover.agent"),
                       "model": lb.get("drover.model") or None, "family": lb.get("drover.family"),
                       "machine": machine_of(t["address"]), "started": int(time.time())}
    return None


def mission_digest(data):
    lines = [f"- {data['id']} (at most {data.get('parallel', 3)} tasks at once"
             f"{', auto: its workers and reviewers run unattended' if data.get('auto') else ''}): {data['goal']}"]
    if data.get("images"):
        lines.append("    images: " + ", ".join(data["images"]))
    for t in data.get("tasks", {}).values():
        rv = (t.get("review") or {}).get("verdict")
        lines.append(f"    {t['id']} [{t['state']}{'/' + rv if rv else ''}] {t['title'][:70]}")
    if not data.get("tasks"):
        lines.append("    (no tasks yet)")
    return "\n".join(lines)


def hc_send(address, text):
    code, out, err = hc(["send", address, text], timeout=90)
    return code == 0, (err or out).strip()


def who(data, name):
    """An agent's address from how agents name each other: coordinator,
    a task id (its worker), review:<task id>, or an hc address."""
    if name == "coordinator":
        return data["coordinator"].get("address")
    if name.startswith("review:"):
        return (data["tasks"].get(name[7:]) or {}).get("review", {}).get("address")
    if name in data["tasks"]:
        return data["tasks"][name].get("address")
    return name


def speaker():
    lb = me()
    role = lb.get("drover.role")
    if role == "coordinator":
        return "coordinator"
    if role == "reviewer":
        return f"review:{lb.get('drover.task-id', '?')}"
    if role:
        return lb.get("drover.task-id") or lb.get("_address", "?")
    return "person"


# --------------------------------------------------------- dashboard tokens

TOKEN_KEYS = ("input", "output", "cache_read", "cache_write", "total")


def timestamp(value):
    if isinstance(value, (int, float)):
        return value
    try:
        return datetime.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (AttributeError, TypeError, ValueError):
        return None


def sum_tokens(values):
    known = [v for v in values if v is not None]
    return {k: sum(v.get(k, 0) for v in known) for k in TOKEN_KEYS} if known else None


class TokenUsage:
    """Index local CLI logs once, then reuse unchanged files across polls.

    Remote usage is unknown: polling must not wait on an offline machine.
    Session selection is deliberately conservative, especially in the shared
    coordinator cwd: take the first session after launch, or the closest one
    within the preceding minute (agent startup can precede our state write).
    """

    def __init__(self):
        self.path = os.path.join(STATE_DIR, "tokens-cache.json")
        self.dirty = False
        self.index = {}
        try:
            with open(self.path) as f:
                cache = json.load(f)
            self.files = cache["files"] if cache.get("version") == 1 else {}
            if not isinstance(self.files, dict):
                self.files = {}
            self.results = cache.get("results") if isinstance(cache.get("results"), dict) else {}
        except (OSError, ValueError, TypeError, KeyError, AttributeError):
            self.files = {}
            self.results = {}

    def read(self, path, agent):
        try:
            stat = os.stat(path)
            signature = [stat.st_mtime_ns, stat.st_size]
            cached = self.files.get(path)
            if isinstance(cached, dict) and cached.get("signature") == signature:
                return cached["session"]
            session = {"started": None, "cwd": None, "tokens": None}
            messages = {}
            with open(path) as f:
                for line in f:
                    try:
                        entry = json.loads(line)
                        if not isinstance(entry, dict):
                            continue
                        if session["started"] is None:
                            session["started"] = timestamp(entry.get("timestamp"))
                        if agent == "claude" and entry.get("type") == "assistant":
                            message = entry.get("message") or {}
                            usage = message.get("usage")
                            if not isinstance(usage, dict):
                                continue
                            tokens = {"input": usage.get("input_tokens", 0),
                                      "output": usage.get("output_tokens", 0),
                                      "cache_read": usage.get("cache_read_input_tokens", 0),
                                      "cache_write": usage.get("cache_creation_input_tokens", 0)}
                            # Streaming copies can contain a later, larger output count.
                            key = message.get("id") or entry.get("uuid") or str(len(messages))
                            previous = messages.get(key, {})
                            tokens = {k: max(v or 0, previous.get(k, 0)) for k, v in tokens.items()}
                            tokens["total"] = sum(tokens.values())
                            messages[key] = tokens
                        elif agent == "codex":
                            payload = entry.get("payload") or {}
                            if entry.get("type") == "session_meta":
                                session["cwd"] = payload.get("cwd")
                                session["started"] = timestamp(payload.get("timestamp")) or session["started"]
                            elif entry.get("type") == "event_msg" and payload.get("type") == "token_count":
                                usage = (payload.get("info") or {}).get("total_token_usage")
                                if not isinstance(usage, dict):
                                    continue
                                # Codex input already includes cached input, unlike Claude.
                                cached_input = usage.get("cached_input_tokens", 0) or 0
                                input_ = usage.get("input_tokens", 0) or 0
                                output = usage.get("output_tokens", 0) or 0
                                session["tokens"] = {"input": max(0, input_ - cached_input), "output": output,
                                                     "cache_read": cached_input,
                                                     "cache_write": usage.get("cache_write_input_tokens", 0) or 0,
                                                     "total": usage.get("total_tokens", input_ + output)}
                    except (ValueError, TypeError, AttributeError):
                        continue  # partial writes and unfamiliar records are harmless
            if agent == "claude":
                session["tokens"] = sum_tokens(messages.values())
            self.files[path] = {"signature": signature, "session": session}
            self.dirty = True
            return session
        except (OSError, UnicodeError, KeyError):
            return None

    RESULT_TTL = 30  # seconds a scan result is reused, so a 1.5s dashboard poll stays cheap

    def get(self, agent, cwd, started, machine, until=None):
        if agent not in ("claude", "codex") or not cwd or machine not in (None, local_name()):
            return None
        key = json.dumps([agent, cwd, started, machine, until])
        hit = self.results.get(key)
        if isinstance(hit, list) and len(hit) == 2 and 0 <= time.time() - hit[0] < self.RESULT_TTL:
            return hit[1]
        value = self._scan(agent, cwd, started, until)
        self.results[key] = [time.time(), value]
        self.dirty = True
        return value

    def _scan(self, agent, cwd, started, until):
        cwd = os.path.abspath(os.path.expanduser(cwd))
        key = (agent, cwd if agent == "claude" else None)
        if key not in self.index:
            if agent == "claude":
                folder = cwd.replace("/", "-").replace(".", "-")
                paths = glob.glob(os.path.join(HOME, ".claude", "projects", glob.escape(folder), "*.jsonl"))
            else:
                paths = glob.glob(os.path.join(HOME, ".codex", "sessions", "*", "*", "*", "rollout-*.jsonl"))
            self.index[key] = [s for p in paths if (s := self.read(p, agent)) is not None]
        sessions = [s for s in self.index[key]
                    if s.get("started") is not None and s["started"] >= started - 60
                    and (until is None or s["started"] < until)
                    and (agent == "claude" or s.get("cwd") == cwd)]
        after = [s for s in sessions if s["started"] >= started]
        if after:
            closest = min(s["started"] for s in after)
        elif sessions:
            closest = max(s["started"] for s in sessions)
        else:
            return None
        return sum_tokens(s["tokens"] for s in sessions if s["started"] == closest)

    def save(self):
        for path in list(self.files):
            if not os.path.exists(path):
                del self.files[path]
                self.dirty = True
        if self.dirty:
            now = time.time()
            self.results = {k: v for k, v in self.results.items()
                            if isinstance(v, list) and 0 <= now - v[0] < self.RESULT_TTL}
            try:
                write_json(self.path, {"version": 1, "files": self.files, "results": self.results})
            except OSError:
                pass  # read-only state directories must not break the dashboard


def activity_text(status, msg, out_until=None, now=None):
    """One plain-language line for what an agent is doing."""
    if out_until:
        return f"sleeping until {fmt_until(out_until, now)}"
    if status == "blocked":
        return "waiting for you"
    if status == "gone":
        return "terminal closed"
    return " ".join(str(msg).split()) if msg else {"idle": "idle", "done": "finished"}.get(status, "working")


def needs_you_action(impediment, agent, mission_id):
    """The command the person runs to clear an impediment that only they can clear, or None."""
    if impediment["kind"] == "needs_you" and agent and agent.get("address"):
        return f"hc attach {agent['address']}"
    if impediment["kind"] == "merge_failed" and impediment.get("task"):
        return f"drover task merge {impediment['task']} --mission {mission_id}"
    return None


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]")


def cmd_peek(a, cfg):
    data = current_mission(a.mission).read()
    addr = who(data, a.who)
    if not addr:
        die(f"nobody called {a.who!r} in mission {data['id']}")
    code, screen, err = hc(["read", addr, "--lines", str(a.lines)], timeout=20)
    if code != 0:
        die(f"could not read {a.who} ({addr}): {(err or screen).strip()}")
    lines = [ln.rstrip() for ln in ANSI_RE.sub("", screen).replace("\r", "").split("\n")]
    while lines and not lines[-1]:
        lines.pop()
    status, msg = "", None
    code, got, _ = hc(["get", addr, "--json"], timeout=20)
    try:
        t = json.loads(got) if code == 0 else {}
        t = t.get("terminal", t)
        raw = t.get("status")
        status = (raw.get("state") if isinstance(raw, dict) else raw) or ""
        msg = (raw.get("msg") if isinstance(raw, dict) else t.get("msg")) or None
    except (ValueError, AttributeError):
        pass
    emit({"who": a.who, "address": addr, "lines": lines, "status": status, "msg": msg},
         a.json, lambda d: "\n".join(d["lines"]))


