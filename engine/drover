# ---------------------------------------------------------------- helpers

def die(msg, code=1):
    print(f"drover: {msg}", file=sys.stderr)
    sys.exit(code)


def local_name():
    return socket.gethostname().split(".")[0]


def merged(base, over):
    """Deep-merge `over` onto `base` (dicts only; lists and values replace)."""
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = merged(base[k], v) if isinstance(base.get(k), dict) and isinstance(v, dict) else v
    return out


def load_config():
    try:
        with open(CONFIG) as f:
            user = json.load(f)
    except FileNotFoundError:
        user = {}
    except json.JSONDecodeError as e:
        die(f"{CONFIG} is not valid JSON: {e}")
    return merged(DEFAULT_CONFIG, user)


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp-{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def machine_cfg(cfg, name):
    return merged(cfg["machine_defaults"], cfg["machines"].get(name, {}))


def hc(args, timeout=60):
    """Run hc; return (code, stdout, stderr)."""
    try:
        p = subprocess.run(["hc", *args], capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        die("hc (herdr-core) is not installed")
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"


def on_args(machine):
    return [] if machine is None else ["--on", machine]


def hc_target(cfg_name):
    """hc's machine name for a drover machine name: None means this computer."""
    return None if cfg_name == local_name() else cfg_name


def remote_sh(machine, script, timeout=40):
    """Run a POSIX script in that machine's login+interactive shell, so PATH has
    the tools people installed (mise, Homebrew). Output before the marker (MOTDs,
    fastfetch) is dropped."""
    wrapper = 'exec "${SHELL:-/bin/sh}" -lic "$1" </dev/null 2>/dev/null'
    code, out, err = hc(["exec", *on_args(machine), "--timeout", str(timeout), "sh", "-c", wrapper, "_",
                         "echo __DROVER__\n" + script], timeout=timeout + 10)
    if "__DROVER__" not in out:
        return code or 1, "", err.strip() or "no answer"
    return code, out.split("__DROVER__", 1)[1].lstrip("\n"), err


def emit(data, as_json, text):
    if as_json:
        json.dump(data, sys.stdout, indent=2)
        print()
    else:
        print(text(data))


# ---------------------------------------------------------------- probe

PROBE = r"""
echo os=$(uname -s)
echo arch=$(uname -m)
echo cpus=$( (nproc || sysctl -n hw.ncpu) 2>/dev/null)
if [ -r /proc/meminfo ]; then
  echo mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
else
  echo mem_kb=$(( $(sysctl -n hw.memsize) / 1024 ))
fi
if [ -r /proc/loadavg ]; then echo load=$(cut -d' ' -f1 /proc/loadavg)
else echo load=$(sysctl -n vm.loadavg | awk '{print $2}'); fi
echo disk_free_kb=$(df -Pk "$HOME" | awk 'NR==2{print $4}')
echo home=$HOME
power=unknown
if command -v pmset >/dev/null 2>&1; then
  if pmset -g batt | head -1 | grep -q 'AC Power'; then power=ac; else power=battery; fi
else
  bat=0; ac=0
  for d in /sys/class/power_supply/*; do
    [ -r "$d/type" ] || continue
    case $(cat "$d/type") in
      Battery) bat=1 ;;
      Mains) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && ac=1 ;;
    esac
  done
  if [ $bat = 0 ] || [ $ac = 1 ]; then power=ac; else power=battery; fi
fi
echo power=$power
printf tools=
for c in TOOLS; do command -v "$c" >/dev/null 2>&1 && printf '%s,' "$c"; done
echo
"""


def probe_one(cfg, name, hc_state):
    t0 = time.time()
    m = {"name": name, "local": name == local_name(), "online": False, "probed_at": int(t0)}
    if hc_state not in (None, "connected"):
        m["error"] = f"hc: {hc_state}"
        return m
    bins = sorted({a["bin"] for a in cfg["agents"].values()} | {"git", "hc"})
    code, out, err = remote_sh(hc_target(name), PROBE.replace("TOOLS", " ".join(bins)))
    if not out:
        m["error"] = err or f"exit {code}"
        return m
    kv = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    num = lambda k, f=float: f(kv[k]) if kv.get(k, "").replace(".", "", 1).isdigit() else None
    m.update({
        "online": True,
        "os": kv.get("os"), "arch": kv.get("arch"), "home": kv.get("home"),
        "cpus": num("cpus", int), "load": num("load"),
        "mem_gb": round(num("mem_kb") / 2**20, 1) if num("mem_kb") else None,
        "disk_free_gb": round(num("disk_free_kb") / 2**20, 1) if num("disk_free_kb") else None,
        "power": kv.get("power", "unknown"),
        "tools": [t for t in kv.get("tools", "").split(",") if t],
        "probe_ms": int((time.time() - t0) * 1000),
    })
    return m


def hc_machines():
    """[(name, state)] for this computer and every machine hc knows."""
    code, out, err = hc(["machine", "ls", "--json"])
    rows = json.loads(out).get("machines", []) if code == 0 and out.strip() else []
    return [(local_name(), None)] + [(r["name"], r.get("state")) for r in rows if not r.get("temporary")]


def probe(cfg):
    ms = hc_machines()
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        machines = list(pool.map(lambda m: probe_one(cfg, *m), ms))
    data = {"updated": int(time.time()), "machines": machines}
    write_json(FLEET, data)
    return data


def fleet(cfg, max_age=PROBE_MAX_AGE):
    try:
        with open(FLEET) as f:
            data = json.load(f)
        if time.time() - data.get("updated", 0) <= max_age:
            return data
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return probe(cfg)


# ---------------------------------------------------------------- agents

class Inconclusive(Exception):
    """hc could not say whether a terminal exists (failure or timeout), as opposed to it being gone."""


GONE = re.compile(r"not found|no such|unknown terminal|does not exist|no terminal", re.I)


def drover_terminals(strict=False):
    """Live terminals started by drover, on every machine. With strict, raise
    Inconclusive when hc ls/get fails for anything but a confirmed-gone terminal."""
    # `hc ls` leaves labels out, so ask `hc get` for each terminal's (in parallel).
    code, out, err = hc(["ls", "--json"])
    if code != 0:
        if strict:
            raise Inconclusive(f"hc ls failed ({code}): {(err or out).strip()[:200]}")
        return []
    if not out.strip():
        return []
    try:
        rows = json.loads(out).get("terminals", [])
    except json.JSONDecodeError:
        if strict:
            raise Inconclusive("hc ls gave unreadable output")
        return []

    def full(t):
        c, o, e = hc(["get", t["address"], "--json"], timeout=15)
        if c != 0:  # it may have disappeared since ls
            if strict and not GONE.search(e + o):
                raise Inconclusive(f"hc get {t['address']} failed ({c}): {(e or o).strip()[:200]}")
            return {}
        try:
            detail = json.loads(o)
            return {**t, **detail.get("terminal", detail)}
        except json.JSONDecodeError:
            if strict:
                raise Inconclusive(f"hc get {t['address']} gave unreadable output")
            return t
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        rows = list(pool.map(full, rows))
    return [t for t in rows if "drover.role" in (t.get("labels") or {})]


def machine_of(address):
    return address.split("/", 1)[0] if "/" in address else local_name()


def labels(t):
    return t.get("labels") or {}


# ---------------------------------------------------------------- capacity

CAPACITY = os.path.join(STATE_DIR, "capacity.json")
DEFAULT_OUT_SECONDS = 3600  # when a message gives no reset time

# What each CLI prints when it is out of capacity: (regex, reason). Add a line
# to teach drover a new message. "*" patterns apply to every agent.
CAPACITY_PATTERNS = {
    "claude": [
        (r"5-hour limit reached", "5-hour limit"),
        (r"weekly limit reached", "weekly limit"),
        (r"(?:claude )?usage limit reached", "usage limit"),
        (r"you(?:'|’)ve hit your (?:session |weekly |usage )?limit", "usage limit"),
        (r"limit reached\s*[∙·•\-|]\s*resets", "usage limit"),
    ],
    "codex": [
        (r"you(?:'|’)ve hit your usage limit", "usage limit"),
        (r"you(?:'|’)ve reached your usage limit", "usage limit"),
        (r"usage limit (?:reached|exceeded)", "usage limit"),
        # the interactive prompt codex shows before it stops
        (r"approaching rate limits", "approaching rate limit"),
        (r"switch to .{0,60} for lower credit usage", "approaching rate limit"),
    ],
    "cursor": [
        (r"you(?:'|’)ve hit your (?:usage )?limit", "usage limit"),
        (r"you(?:'|’)ve reached your (?:\w+ )?(?:usage )?limit", "usage limit"),
        (r"out of (?:usage|requests)", "out of usage"),
    ],
    "copilot": [
        (r"you(?:'|’)ve (?:hit|reached) your .{0,40}(?:rate|usage) limit", "usage limit"),
        (r"(?:premium )?quota (?:exceeded|exhausted)", "quota exhausted"),
        (r"rate[- ]limit(?:ed| exceeded| reached)", "rate limit"),
    ],
    "*": [
        (r"usage limit", "usage limit"),
        (r"rate limit(?:ed| exceeded| reached)", "rate limit"),
        (r"too many requests", "rate limit"),
    ],
}
CAPACITY_ALIASES = {"cursor-agent": "cursor"}

_UNITS = {"d": 86400, "h": 3600, "m": 60, "s": 1}
_DURATION = re.compile(r"(\d+)\s*(days?|d|hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)\b", re.I)
_MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
_CLOCK = re.compile(
    r"(?:(?P<mon>jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s+(?P<day>\d{1,2})(?:st|nd|rd|th)?,?\s*"
    r"(?P<year>\d{4})?,?\s*(?:at\s+)?)?"
    r"(?P<h>\d{1,2})(?::(?P<min>\d{2}))?\s*(?P<ap>[ap]\.?m\.?)?(?![\d:])", re.I)


def parse_duration(text):
    """'2h 14m', '90 minutes', '1d' -> seconds, or None."""
    found = _DURATION.findall(text)
    if not found or re.sub(_DURATION, "", text).strip(" ,and"):
        return None
    return sum(int(n) * _UNITS[u[0].lower()] for n, u in found)


def parse_reset(text, now):
    """Reset epoch from a message: 'in 2h 14m', 'resets at 3pm', 'try again at Nov 20th, 2026 3:05 AM'."""
    m = re.search(r"\b(?:in|after)\s+((?:\d+\s*[a-z]+[\s,]*(?:and\s+)?)+)", text, re.I)
    if m:
        secs = parse_duration(m.group(1).strip())
        if secs:
            return now + secs
    for m in re.finditer(r"(?:\bat|\bresets?(?:\s+at)?|\buntil|\bafter)\s+(?:on\s+)?(?=[\dA-Za-z])", text, re.I):
        c = _CLOCK.match(text, m.end())
        if not c:
            continue
        # a bare hour ("at 5") is too ambiguous; need am/pm, a colon time or a date
        if not (c.group("ap") or c.group("min") or c.group("mon")):
            continue
        hour, minute = int(c.group("h")), int(c.group("min") or 0)
        ap = (c.group("ap") or "").lower()
        if ap:
            if not 1 <= hour <= 12:
                continue
            hour = hour % 12 + (12 if ap[0] == "p" else 0)
        if hour > 23 or minute > 59:
            continue
        base = datetime.datetime.fromtimestamp(now)
        try:
            if c.group("mon"):
                mon = _MONTHS.index(c.group("mon").lower()) + 1
                year = int(c.group("year") or base.year)
                when = datetime.datetime(year, mon, int(c.group("day")), hour, minute)
                if not c.group("year") and when.timestamp() <= now:
                    when = when.replace(year=year + 1)
            else:
                when = base.replace(hour=hour, minute=minute, second=0, microsecond=0)
                if re.search(r"tomorrow", text[max(0, m.start() - 20):c.end() + 5], re.I) or when.timestamp() <= now:
                    when += datetime.timedelta(days=1)
        except ValueError:
            continue
        return when.timestamp()
    return None


def detect_capacity(agent, screen_text, now=None):
    """Is this agent out of capacity per its screen? -> (until_epoch, reason) or None.
    until is now + 1h when the message names no reset time."""
    now = time.time() if now is None else now
    agent = CAPACITY_ALIASES.get(agent, agent)
    hit = None
    for pat, reason in CAPACITY_PATTERNS.get(agent, []) + CAPACITY_PATTERNS["*"]:
        for m in re.finditer(pat, screen_text or "", re.I):
            if hit is None or m.start() > hit[0]:  # the latest message wins
                hit = (m.start(), reason)
    if not hit:
        return None
    # the reset time sits near the message, usually after it
    until = parse_reset(screen_text[hit[0]:hit[0] + 300], now)
    return (int(until) if until and until > now else int(now + DEFAULT_OUT_SECONDS)), hit[1]


@contextlib.contextmanager
def capacity_lock():
    import fcntl
    d = os.path.join(STATE_DIR, "locks")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "capacity.lock"), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def _read_capacity():
    try:
        with open(CAPACITY) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def agents_out(now=None):
    """{agent: {machine?, until, reason, since}} for agents still out of capacity.
    (The store's separate 'usage' key holds cached usage readings, not outages.)"""
    now = time.time() if now is None else now
    return {a: e for a, e in _read_capacity().items()
            if a != "usage" and isinstance(e, dict) and e.get("until", 0) > now}


def _write_capacity(out, usage):
    data = dict(out)
    if usage:
        data["usage"] = usage
    write_json(CAPACITY, data)


def mark_out(agent, until, reason, machine=None):
    agent = CAPACITY_ALIASES.get(agent, agent)
    now = int(time.time())
    entry = {"until": int(until), "reason": reason or "out of capacity", "since": now}
    if machine:
        entry["machine"] = machine
    with capacity_lock():
        data = agents_out(now)
        data[agent] = entry
        _write_capacity(data, _read_capacity().get("usage"))
    return entry


def clear_out(agent):
    """Forget that an agent was out. True if it was recorded."""
    agent = CAPACITY_ALIASES.get(agent, agent)
    with capacity_lock():
        data = agents_out()
        was = data.pop(agent, None) is not None
        _write_capacity(data, _read_capacity().get("usage"))
    return was


# ---------------------------------------------------------------- usage (proactive quota)

USAGE_TTL = 120  # seconds a reading (or a "nothing available") stays cached


def _usage_read(agent, now):
    """Read an agent CLI's plan usage from local files, without running the agent.
    -> {used_percent, window, resets_at, source, read_at} for the fullest window that has not
    reset yet, or None. Self-contained (stdlib only): it is also shipped to remote machines.
      claude  the statusline input JSON carries rate_limits {five_hour, seven_day: used_percentage,
              resets_at}; herdboard's statusline hook caches it in ~/.cache/herdboard/claude-limits.json
      codex   every turn writes a token_count event with rate_limits {primary, secondary:
              used_percent, window_minutes, resets_at | resets_in_seconds} into ~/.codex/sessions/**.jsonl
      cursor-agent, copilot: no local usage data exists (no file, no offline command), so None."""
    import datetime, glob, json, os
    home = os.path.expanduser("~")
    wins = []  # (used_percent, window label, resets_at)
    source, read_at = None, now

    def label(minutes):
        return f"{round(minutes / 1440)}d" if minutes >= 2880 else f"{round(minutes / 60)}h"

    if agent == "claude":
        source = os.environ.get("DROVER_CLAUDE_LIMITS") or os.path.join(home, ".cache", "herdboard", "claude-limits.json")
        try:
            with open(source) as f:
                doc = json.load(f)
            read_at = doc.get("ts") or now
            for key, lab in (("five_hour", "5h"), ("seven_day", "7d")):
                w = (doc.get("rate_limits") or {}).get(key) or {}
                if w.get("used_percentage") is not None and w.get("resets_at"):
                    wins.append((float(w["used_percentage"]), lab, float(w["resets_at"])))
        except (OSError, ValueError, AttributeError):
            return None
    elif agent == "codex":
        root = os.path.join(os.environ.get("CODEX_HOME") or os.path.join(home, ".codex"), "sessions")
        files = sorted(glob.glob(os.path.join(root, "**", "*.jsonl"), recursive=True),
                       key=lambda p: os.path.getmtime(p), reverse=True)[:40]
        for path in files:
            try:
                with open(path, "rb") as f:
                    f.seek(0, 2)
                    f.seek(max(0, f.tell() - 262144))
                    lines = f.read().decode("utf-8", "replace").splitlines()
            except OSError:
                continue
            for line in reversed(lines):
                if '"rate_limits"' not in line:
                    continue
                try:
                    ev = json.loads(line)
                    rl = ev["payload"]["rate_limits"]
                    at = datetime.datetime.fromisoformat(ev["timestamp"].replace("Z", "+00:00")).timestamp()
                except (ValueError, KeyError, TypeError):
                    continue
                for w in (rl.get("primary"), rl.get("secondary")) if isinstance(rl, dict) else ():
                    if not isinstance(w, dict) or w.get("used_percent") is None:
                        continue
                    resets = w.get("resets_at") or (at + w["resets_in_seconds"] if w.get("resets_in_seconds") is not None else None)
                    if resets:
                        wins.append((float(w["used_percent"]), label(w.get("window_minutes") or 300), float(resets)))
                if wins:  # events with rate_limits null (no plan data) are skipped
                    source, read_at = path, at
                    break
            if wins:
                break
    else:
        return None
    wins = [w for w in wins if w[2] > now]  # a window that already reset says nothing about now
    if not wins:
        return None
    pct, win, resets = max(wins)
    return {"used_percent": pct, "window": win, "resets_at": int(resets), "source": source, "read_at": int(read_at)}


def usage_probe(agent, machine=None, now=None, max_age=USAGE_TTL):
    """Plan usage of an agent CLI on a machine (None = this computer) or None when unknown.
    Cached in the capacity store's 'usage' key for max_age seconds; remote machines are read through
    remote_sh with the same self-contained helper, and any failure just means 'unknown'."""
    agent = CAPACITY_ALIASES.get(agent, agent)
    now = time.time() if now is None else now
    key = f"{agent}@{machine or 'local'}"
    hit = (_read_capacity().get("usage") or {}).get(key)
    if isinstance(hit, dict) and now - hit.get("cached_at", 0) < max_age:
        return hit.get("reading")
    reading = None
    try:
        if machine is None:
            reading = _usage_read(agent, now)
        else:
            src = inspect.getsource(_usage_read) + f"\nprint(json.dumps(_usage_read({agent!r}, {now!r})))\n"
            code, out, err = remote_sh(machine, "python3 -c " + shlex.quote("import json\n" + src) + " 2>/dev/null", timeout=30)
            reading = json.loads(out.strip().splitlines()[-1]) if not code and out.strip() else None
    except Exception:
        reading = None
    with capacity_lock():
        data = _read_capacity()
        usage = data.get("usage") if isinstance(data.get("usage"), dict) else {}
        usage[key] = {"cached_at": int(now), "reading": reading}
        _write_capacity(agents_out(now), usage)
    return reading


def usage_list(cfg, now=None):
    """Usage rows for 'drover agent list' and the dashboard: this computer's agents (read now, cached
    briefly) plus whatever remote readings routing has cached."""
    now = time.time() if now is None else now
    rows, seen = [], set()
    for name in cfg["agents"]:
        name = CAPACITY_ALIASES.get(name, name)
        if name in seen:
            continue
        seen.add(name)
        u = usage_probe(name, None, now)
        if u:
            rows.append({"agent": name, "machine": None, **u})
    for key, hit in sorted((_read_capacity().get("usage") or {}).items()):
        agent, _, machine = key.partition("@")
        if machine != "local" and isinstance(hit, dict) and hit.get("reading") and now - hit.get("cached_at", 0) < 3600:
            rows.append({"agent": agent, "machine": machine, **hit["reading"]})
    for r in rows:
        r["name"] = cfg["agents"].get(r["agent"], {}).get("name") or r["agent"]
    return rows


def fmt_usage(u, now=None):
    return f"{u['used_percent']:.0f}% of {u['window']} window, resets {fmt_until(u['resets_at'], now)}"


def fmt_until(until, now=None):
    now = time.time() if now is None else now
    t = datetime.datetime.fromtimestamp(until)
    same_day = t.date() == datetime.datetime.fromtimestamp(now).date()
    return t.strftime("%H:%M" if same_day else "%Y-%m-%d %H:%M")


def parse_until(text, now=None):
    """--until value: a duration ('2h30m') or an ISO date/time (local time unless it has an offset)."""
    now = time.time() if now is None else now
    secs = parse_duration(text.strip())
    if secs:
        return int(now + secs)
    try:
        return int(datetime.datetime.fromisoformat(text.strip()).timestamp())
    except ValueError:
        die(f"--until {text!r}: use a duration like 2h30m or an ISO time like 2026-11-14T09:00")


def cmd_agent(a, cfg):
    if a.action == "out":
        if not a.agent:
            die("agent out: which agent?")
        until = parse_until(a.until) if a.until else int(time.time() + DEFAULT_OUT_SECONDS)
        entry = mark_out(a.agent, until, a.reason or "set by hand", machine=a.machine)
        data = {"agent": a.agent, **entry}
        emit(data, a.json, lambda d: f"{d['agent']} out until {fmt_until(d['until'])} ({d['reason']})")
    elif a.action == "clear":
        if not a.agent:
            die("agent clear: which agent?")
        data = {"agent": a.agent, "cleared": clear_out(a.agent)}
        emit(data, a.json, lambda d: f"{d['agent']} " + ("is available again" if d["cleared"] else "was not marked out"))
    else:
        data = {"out": agents_out(), "usage": usage_list(cfg)}
        def text(d):
            lines = [f"{n}: out until {fmt_until(e['until'])} ({e['reason']})"
                     + (f" on {e['machine']}" if e.get("machine") else "") for n, e in d["out"].items()]
            lines += [f"{u['name']}: used {fmt_usage(u)}" + (f" on {u['machine']}" if u["machine"] else "")
                      for u in d["usage"]]
            return "\n".join(lines) or "no agent is out of capacity; no usage data available"
        emit(data, a.json, text)


