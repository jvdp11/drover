                 "content": {"mod": "drover-dashboard", "props": props}}]}


def pasture_window(repo, mission):
    """Open (or bring forward) the project's pasture in its own Herdr window: its own HERDR_APP_HOME."""
    if not shutil.which("herdr-app"):
        die("herdr-app is not installed")
    name = os.path.basename(repo.rstrip(os.sep)) or "project"
    home = os.path.join(PASTURE_APPS, f"{slug(name)}-{hashlib.sha1(repo.encode()).hexdigest()[:6]}")
    for d in ("mods", "layouts", "themes"):
        os.makedirs(os.path.join(home, d), exist_ok=True)

    def link(target, path):
        if os.path.islink(path) and os.readlink(path) == target:
            return
        if os.path.lexists(path):
            if not os.path.islink(path):
                return  # never replace a real file someone put there
            os.unlink(path)
        os.symlink(target, path)

    mods = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "herdr", "mods")
    for m in sorted(os.listdir(mods)) if os.path.isdir(mods) else []:
        if m.startswith("drover-"):
            link(os.path.join(mods, m), os.path.join(home, "mods", m))
    for theme in (os.path.join(HOME, ".local", "state", "omarchy", "current", "theme", "herdr-app.json"),
                  os.path.join(HOME, ".config", "herdr-app", "themes", "omarchy.json")):
        if os.path.isfile(theme):
            link(os.path.realpath(theme), os.path.join(home, "themes", "omarchy.json"))
            break
    # Herdr redraws from layout files live, so a running window picks up a new mission too.
    write_json(os.path.join(home, "layouts", "pasture.json"), pasture_layout(repo, name, mission))
    env = {**os.environ, "HERDR_APP_HOME": home}
    running = subprocess.run(["herdr-app", "status"], env=env, capture_output=True, timeout=10).returncode == 0
    if not running:  # Herdr owns these files while it runs
        # Show the pasture layout, and skip Herdr's first-run welcome: this window is not a new install.
        try:
            with open(os.path.join(home, "shared.json")) as f:
                shared = json.load(f)
        except (OSError, ValueError):
            shared = {}
        seed = {"layout": "pasture", "frame.welcomed": "skipped", "workspace.panels": []}
        if not isinstance(shared, dict):
            shared = {}
        if any(k not in shared for k in seed) or shared.get("layout") != "pasture":
            write_json(os.path.join(home, "shared.json"), {**shared, **{k: v for k, v in seed.items() if k not in shared},
                                                           "layout": "pasture"})
        window = os.path.join(home, "window.json")
        if not os.path.exists(window):
            write_json(window, {"state": "normal", "bounds": [120.0, 120.0, 1180.0, 780.0]})
    if running:
        subprocess.run(["herdr-app", "do", "layout.switch", "--name", "pasture"], env=env, capture_output=True, timeout=10)
    # Bare herdr-app opens the window, or raises the one already running for this home.
    subprocess.Popen(["herdr-app"], env=env, cwd=repo, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return {"home": home, "repo": repo, "mission": mission, "running": running}


def cmd_dashboard(a, cfg):
    repo = os.path.abspath(os.path.expanduser(a.repo))
    if a.window:
        r = pasture_window(repo, a.mission)
        emit(r, a.json, lambda r: f"{'raised' if r['running'] else 'opened'} pasture window ({r['home']})")
        return
    rows = [r for r in mission_rows(repo, cfg) if a.all or not r["archived"]]
    selected = next((r for r in rows if r["id"] == a.mission), None) if a.mission else next(
        (r for r in rows if r["state"] == "running"), next((r for r in rows if not r["archived"]), None))
    if a.mission and selected is None:
        die(f"no mission {a.mission} for {repo}")
    now = int(time.time())
    result = {"project": (selected or {}).get("project") or os.path.basename(repo), "repo": repo,
              "missions": [{k: r[k] for k in ("id", "goal", "state", "created", "updated", "tasks", "merged", "archived", "summary")}
                           for r in rows],
              "mission": None, "agents": [], "tasks": [],
              "tokens": {"total": 0, "coordinator": 0, "worker": 0, "reviewer": 0},
              "impediments": [], "needs_you": [], "log": [], "generated": now}
    out = agents_out()
    result["capacity"] = sorted(
        ({"agent": ag, "name": cfg["agents"].get(ag, {}).get("name") or ag, "machine": e.get("machine"),
          "until": e["until"], "reason": e.get("reason"), "since": e.get("since")} for ag, e in out.items()),
        key=lambda c: (c["until"], c["agent"]))
    # 'capacity' stays a list of outages (the herdr mod maps over it), so usage is a sibling key.
    result["usage"] = usage_list(cfg, now)
    if selected:
        m = Mission(selected["id"])
        data = m.read()
        entries = m.entries(None)
        result["mission"] = {k: data.get(k) for k in ("id", "goal", "state", "base", "created", "updated", "summary")}
        result["mission"]["archived"] = selected["archived"]
        result["mission"]["auto"] = bool(data.get("auto"))
        result["mission"]["images"] = data.get("images") or []
        result["log"] = entries[-40:]
        live = {t["address"]: t for t in drover_terminals() if t.get("address")}
        usage = TokenUsage()

        def impediment(kind, severity, who_, task, text, since):
            if data["state"] == "done" or selected["archived"] or data.get("tasks", {}).get(task, {}).get("state") == "dropped":
                return
            result["impediments"].append({"kind": kind, "severity": severity, "who": who_, "task": task,
                                          "text": " ".join(str(text).split()), "since": int(since)})

        def alternatives(task):
            role = {"working": "worker", "changes": "worker", "review": "reviewer"}.get(task["state"])
            if not role or (role == "reviewer" and not task.get("review")):
                return []
            return task_alternatives(cfg, task, role, machine_tools(cfg, task.get("machine")), out, now)

        def add_agent(record, role, task, title, cwd, until=None):
            tid = task.get("id") if task else None
            who_ = "coordinator" if role == "coordinator" else f"review:{tid}" if role == "reviewer" else tid
            started = record.get("started") or (task or data).get("created") or now
            terminal = live.get(record.get("address"))
            lb = labels(terminal or {})
            raw = (terminal or {}).get("status")
            state = raw.get("state") if isinstance(raw, dict) else raw
            msg = raw.get("msg") if isinstance(raw, dict) else (terminal or {}).get("msg")
            missing = terminal is not None and not state and now - started > 60
            status = ("gone" if terminal is None else "blocked" if state in ("blocked", "error") or missing
                      else state if state in ("working", "idle", "done")
                      else "done" if terminal.get("state") in ("exited", "finished", "dead") else "working")
            agent = {"who": who_, "role": role, "task": tid, "title": title,
                     **{k: record.get(k) or lb.get(f"drover.{k}") or None for k in ("agent", "model", "family")},
                     "machine": record.get("machine"), "address": record.get("address"),
                     "status": status, "msg": msg or None, "started": started}
            agent["tokens"] = usage.get(agent["agent"], cwd, started, agent["machine"], until)
            result["agents"].append(agent)
            result["tokens"][role] += (agent["tokens"] or {}).get("total", 0)
            since = ((terminal or {}).get("status_ms") or 0) / 1000 or started
            hit = out.get(CAPACITY_ALIASES.get(agent["agent"], agent["agent"]))
            sleeping = bool(hit and status != "gone" and hit.get("machine") in (None, agent["machine"]))
            agent["since"] = int(since)
            agent["activity"] = activity_text(status, msg, hit["until"] if sleeping else None, now)
            if sleeping:
                impediment("capacity", "warn", who_, tid,
                           f"{agent['agent']} is out of capacity until {fmt_until(hit['until'])} ({hit.get('reason')})",
                           hit.get("since") or now)
            if status == "blocked":
                impediment("needs_you", "block", who_, tid,
                           "waiting on a prompt, no status since start" if missing else msg or "agent needs your attention",
                           started if missing else since)
            if status == "gone" and data["state"] == "running" and (not task or task["state"] != "merged"):
                impediment("gone", "block", who_, tid, "agent terminal no longer exists", (task or data).get("updated") or started)
            if role == "worker" and task["state"] in ("working", "changes") and status == "idle":
                stale_since = max(task.get("updated") or started, since)
                if now - stale_since > 1800:
                    impediment("stale", "warn", who_, tid, "no task update and agent idle for over 30 minutes", stale_since)
            return agent["tokens"]

        add_agent(data.get("coordinator") or {}, "coordinator", None, data["goal"], repo)
        for tid, task in data.get("tasks", {}).items():
            task = {**task, "id": tid}
            if task["state"] == "queued":  # no worktree or agent yet
                result["tasks"].append({**{k: task.get(k) for k in ("id", "title", "state", "agent", "model", "created", "updated")},
                                        "machine": None, "branch": None, "reason": None, "depends_on": task.get("depends_on", []), "alternatives": [],
                                        "rounds": 0, "review": None, "tokens": sum_tokens([])})
                continue
            logs = [e for e in entries if e.get("task") == tid]
            reviews = task.get("review_history", []) + ([task["review"]] if task.get("review") else [])
            # Bound session matching when a worker and reviewer use the same CLI/cwd.
            starts = [r.get("started") for r in reviews if r.get("started")]
            tokens = [add_agent(task, "worker", task, task["title"], task.get("worktree"), min(starts) if starts else None)]
            for i, review in enumerate(reviews):
                until = reviews[i + 1].get("started") if i + 1 < len(reviews) else None
                if i == len(reviews) - 1:
                    tokens.append(add_agent(review, "reviewer", task, f"Review: {task['title']}", task.get("worktree"), until))
                else:
                    prior = usage.get(review.get("agent"), task.get("worktree"),
                                      review.get("started") or task["created"], review.get("machine"), until)
                    tokens.append(prior)
                    result["tokens"]["reviewer"] += (prior or {}).get("total", 0)
            rv = task.get("review")
            result["tasks"].append({**{k: task.get(k) for k in ("id", "title", "state", "agent", "model", "machine", "branch", "created", "updated", "reason")},
                                    "depends_on": task.get("depends_on", []), "alternatives": alternatives(task),
                                    "rounds": sum(e.get("kind") == "review" for e in logs),
                                    "review": {k: rv.get(k) for k in ("agent", "model", "family", "verdict")} if rv else None,
                                    "tokens": sum_tokens(tokens)})
            if task["state"] == "changes":
                verdict = next((e for e in reversed(logs) if e.get("kind") == "verdict"), {})
                impediment("changes", "warn", tid, tid, verdict.get("text") or "review requested changes",
                           verdict.get("at") or task["updated"])
            merge = next((e for e in reversed(logs) if e.get("kind") == "merge"), {})
            if merge.get("failed") and task["state"] != "merged":
                impediment("merge_failed", "block", tid, tid, merge.get("text") or "merge failed", merge["at"])
        if data["state"] == "stopped" and any(t["state"] not in ("merged", "dropped") for t in data.get("tasks", {}).values()):
            impediment("stopped", "warn", "coordinator", None, "mission stopped with unmerged tasks", data["updated"])
        result["tokens"]["total"] = sum(result["tokens"][k] for k in ("coordinator", "worker", "reviewer"))
        by_who = {x["who"]: x for x in result["agents"]}
        for i in result["impediments"]:
            action = needs_you_action(i, by_who.get(i["who"]), data["id"])
            if action:
                result["needs_you"].append({**i, "action": action})
        usage.save()
    emit(result, a.json, fmt_dashboard)


def fmt_dashboard(data):
    mission = data["mission"]
    lines = [f"{data['project']}  {data['repo']}"]
    lines.extend(f"Out: {c['name']} until {fmt_until(c['until'], data['generated'])}"
                 + (f" ({c['reason']})" if c.get("reason") else "") + (f" on {c['machine']}" if c.get("machine") else "")
                 for c in data.get("capacity") or [])
    if not mission:
        return "\n".join(lines + ["  No missions yet."])
    lines.append(f"{mission['id']}  {mission['state']}  {mission['goal']}")
    lines.extend(f"  {a['who']:<12} {a['status']:<8} {a['agent']}@{a['machine']}"
                 + (f"  {a['msg']}" if a['msg'] else "") for a in data["agents"])
    lines.extend(f"  {t['id']:<4} {t['state']:<9} {t['title']}  ({t['rounds']} reviews)" for t in data["tasks"])
    lines.append("  Tokens: " + ", ".join(f"{k}={v:,}" for k, v in data["tokens"].items()))
    lines.extend(f"  {i['severity'].upper()} {i['who']}: {i['text']}" for i in data["impediments"])
    return "\n".join(lines)


@contextlib.contextmanager
def repo_lock(repo):
    """Serialize mission starts per canonical repo path (lookup, launch, adoption)."""
    import fcntl
    d = os.path.join(STATE_DIR, "locks")
    os.makedirs(d, exist_ok=True)
    name = "mission-start-" + hashlib.sha256(os.path.realpath(repo).encode()).hexdigest()[:24] + ".lock"
    with open(os.path.join(d, name), "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def mission_extras(data):
    """What a coordinator must know about a mission beyond its goal: unattended and attached images."""
    out = ""
    if data.get("auto"):
        out += (f"\n\nMission {data['id']} is AUTO (unattended): every worker and reviewer you start for it runs "
                "with its CLI's autonomy flags and never waits for approvals. Don't ask the person to approve "
                "commands; if you were started without such flags yourself, say so in your report.")
    if data.get("images"):
        out += ("\n\nAttached images for this mission (absolute paths): " + json.dumps(data["images"]) +
                "\nRead them with your file tools before planning, and point workers to the paths they need.")
    return out


def warn_remote_images(images, machine):
    if images and hc_target(machine) is not None:
        print(f"drover: warning: images are local to {local_name()}; the coordinator runs on {machine} "
              "and may not be able to read them (they are not copied over hc)", file=sys.stderr)


def mission_start(a, cfg):
    if not a.goal:
        die("give the mission a goal")
    repo = os.path.abspath(os.path.expanduser(a.repo))
    facts = git_facts(repo)
    if not facts:
        die(f"{tilde(repo)} is not a git repo")
    sources = [os.path.abspath(os.path.expanduser(p)) for p in (a.image or [])]
    for path in sources:
        if not os.path.isfile(path):
            die(f"image is missing or not a file: {path}")
    coord = find_coordinator(repo)  # may die when hc cannot be checked: before anything is created
    mid = time.strftime("%y%m%d-%H%M") + "-" + slug(a.goal, 20)
    mdir = os.path.abspath(os.path.join(MISSIONS, mid))
    os.makedirs(mdir)
    images = []
    if sources:
        os.makedirs(os.path.join(mdir, "images"))
        for n, path in enumerate(sources, 1):
            dest = os.path.join(mdir, "images", f"{n}{os.path.splitext(path)[1] or '.img'}")
            try:
                shutil.copyfile(path, dest)
            except OSError as e:
                shutil.rmtree(mdir)
                die(f"could not copy image {path}: {e}")
            images.append(dest)
    data = {"id": mid, "goal": a.goal, "parallel": a.parallel, "auto": bool(a.auto), "images": images, "repo": repo, "project": os.path.basename(repo),
            "base": facts.get("branch") or "main", "created": int(time.time()), "created_ns": time.time_ns(), "updated": int(time.time()),
            "space": a.space or None, "state": "starting", "coordinator": {}, "tasks": {}, "next_task": 1}
    write_json(os.path.join(mdir, "mission.json"), data)
    m = Mission(mid)
    m.log("mission", "person", "coordinator", a.goal)
    # Adopt-or-reuse: one coordinator per project.
    others = [x for x in running_missions(repo) if x.read()["id"] != mid]
    if coord:
        m.update(lambda x: x.update({"state": "running", "coordinator": coord}))
        msg = NEW_MISSION_MSG.format(mid=mid, goal=a.goal, parallel=a.parallel) + mission_extras(data)
        warn_remote_images(images, coord["machine"])
        ok, err = hc_send(coord["address"], msg)
        if not ok:
            print(f"drover: warning: could not message the coordinator ({err})", file=sys.stderr)
        m.log("mission", "drover", "coordinator", f"assigned to the project's coordinator ({coord['address']})")
        ensure_watcher(cfg)
        emit({"mission": m.read(), "coordinator": coord, "reused": True, "notified": ok}, a.json,
             lambda x: f"mission {mid}: existing coordinator {coord['agent']} on {coord['machine']} ({coord['address']})")
        return
    brief = COORDINATOR_BRIEF.format(mid=mid, repo=tilde(repo), goal=a.goal, parallel=a.parallel,
                                     extra=mission_extras(data))
    if others:
        brief += ("\n\nThe previous coordinator is gone. You also take over these still-running missions "
                  "(pass each one's own --mission id):\n" + "\n".join(mission_digest(x.read()) for x in others))
    extra = {"drover.repo": repo}
    if a.space:  # show the coordinator as one tab per project in the project's space
        extra.update({"herdr.space": a.space, "herdr.tab": coordinator_tab(repo)})
    started = int(time.time())
    d = start_agent(cfg, "coordinator", repo, brief, a.goal, labels_extra=extra,
                    name=f"coord-{slug(os.path.basename(repo), 16)}-{time.strftime('%m%d%H%M')}", auto=a.auto)
    if not d["agent"]:
        shutil.rmtree(mdir)
        emit(d, a.json, fmt_route)
        sys.exit(3)
    warn_remote_images(images, d["machine"])
    coord = {"address": d["address"], "agent": d["agent"], "model": d.get("model"),
             "family": d["family"], "machine": d["machine"], "started": started}
    m.update(lambda x: x.update({"state": "running", "coordinator": coord}))
    for x in others:
        x.update(lambda y: y.update({"coordinator": coord}))
        x.log("mission", "drover", "coordinator", f"adopted by new coordinator ({coord['address']})")
    ensure_watcher(cfg)
    emit({"mission": m.read(), "route": d, "adopted": [x.read()["id"] for x in others]}, a.json,
         lambda x: f"mission {mid}: coordinator {d['agent']} on {d['machine']} ({d['address']})")
    return


def cmd_mission(a, cfg):
    if a.action == "start":
        repo = os.path.abspath(os.path.expanduser(a.repo))
        with repo_lock(repo):
            return mission_start(a, cfg)
    if a.action == "list":
        rows = mission_rows(os.path.abspath(os.path.expanduser(a.repo)) if a.repo != "." else None, cfg)
        rows = [r for r in rows if a.all or not r["archived"]]
        emit({"missions": rows}, a.json, lambda d: "\n".join(
            f"  {r['id']:<34} {r['state']:<9} {r['merged']}/{r['tasks']}  {r['goal'][:60]}" for r in d["missions"]))
        return
    if a.action in ("archive", "unarchive") and not a.goal:
        die(f"give the mission id: drover mission {a.action} <id>")
    m = current_mission(a.goal if a.action in ("archive", "unarchive") else a.mission)
    if a.action == "done":
        if not a.goal.strip():
            die("give the mission a summary")

        def finish(x):
            active = [tid for tid, t in x.get("tasks", {}).items()
                      if t["state"] in ("working", "review", "changes", "approved")]
            if active and not a.force:
                die(f"tasks still active: {', '.join(active)}; use --force to finish anyway")
            x.update(state="done", summary=a.goal, done_at=x.get("done_at") or int(time.time()))
        m.update(finish)
        m.log("done", "coordinator", "person", a.goal)
        emit({"mission": m.read()["id"], "state": "done", "summary": a.goal}, a.json,
             lambda d: f"{d['mission']} done: {d['summary']}")
        return
    if a.action in ("archive", "unarchive"):
        def archive(x):
            if x["state"] not in ("done", "stopped"):
                die("only done or stopped missions can be archived or unarchived")
            x["archived"] = a.action == "archive"
            if not x["archived"]:
                x["unarchived_at"] = int(time.time())
        m.update(archive)
        m.log(a.action, "person", "mission", a.action)
        emit({"mission": a.goal, "archived": a.action == "archive"}, a.json,
             lambda d: f"{a.goal} {a.action}d")
        return
    if a.action == "show":
        data = m.read()
        data.setdefault("auto", False)
        data.setdefault("images", [])
        live = {t["address"]: t for t in drover_terminals()}
        for who_ in [data["coordinator"], *data["tasks"].values(), *[t.get("review", {}) for t in data["tasks"].values()]]:
            t = live.get(who_.get("address"))
            who_["status"] = ((t.get("status") or "running") if t else ("gone" if who_.get("address") else None))
        data["log"] = m.entries(a.log)

        def text(d):
            lines = [f"{d['id']}  {d['state']}  {d['goal']}",
                     f"  coordinator {d['coordinator'].get('agent')} on {d['coordinator'].get('machine')} ({d['coordinator'].get('status')})"]
            for t in d["tasks"].values():
                rv = t.get("review", {})
                where = f"{t['agent']}@{t['machine']}" if t.get("machine") else "-"
                lines.append(f"  {t['id']:<4} {t['state']:<9} {where}  {t['title'][:50]}"
                             + (f"  after {','.join(t['depends_on'])}" if t.get("depends_on") else "")
                             + (f"  review: {rv.get('agent')} {rv.get('verdict') or ''}" if rv else ""))
            return "\n".join(lines)
        emit(data, a.json, text)
        return
    if a.action == "stop":
        data = m.read()
        # Same lock as mission start: no new mission may adopt the coordinator between the
        # shared-coordinator check and the kill.
        with repo_lock(data["repo"]):
            m.update(lambda x: x.update({"state": "stopped"}))
            caddr = data["coordinator"].get("address")
            shared = any(same_address(caddr, x.read()["coordinator"].get("address")) for x in running_missions(data["repo"]))
            for addr in [None if shared else caddr, *[t.get("address") for t in data["tasks"].values()],
                         *[t.get("review", {}).get("address") for t in data["tasks"].values()]]:
                if addr:
                    hc(["kill", addr])
        m.log("mission", "person", "all", "stopped")
        emit({"stopped": data["id"]}, a.json, lambda d: f"stopped {d['stopped']}")


ACTIVE_STATES = ("working", "done", "review", "changes", "approved")


def project_test_command(cfg, repo, worktree):
    """The test command for a repo: its `projects` entry's test_command, else unittest if there is a tests/ folder."""
    real = os.path.realpath(repo)
    for v in (cfg.get("projects") or {}).values():
        if os.path.realpath(os.path.expanduser(v.get("path", ""))) == real and v.get("test_command"):
            return v["test_command"]
    if os.path.isdir(os.path.join(worktree, "tests")):
        return "python3 -m unittest discover tests"
    return None


def auto_resolve_merge(cfg, repo, base, worktree, test_command=None):
    """Merge `base` into the task branch in its worktree, resolving only safe conflicts, and test the result.
    Returns (ok, detail, conflicting files). On failure the worktree is back at its pre-merge commit."""
    import fnmatch
    import tempfile

    def git(*args, **kw):
        return subprocess.run(["git", "-C", worktree, *args], capture_output=True, text=True, **kw)
    if not os.path.isdir(worktree):
        return False, "worktree not available", []
    pre = git("rev-parse", "HEAD").stdout.strip()
    if not pre:
        return False, "worktree not available", []

    def undo():
        if git("rev-parse", "-q", "--verify", "MERGE_HEAD").returncode == 0:
            git("merge", "--abort")
        git("reset", "--hard", pre)
    r = git("merge", "--no-edit", base)
    conflicts = []
    if r.returncode != 0:
        conflicts = git("diff", "--name-only", "--diff-filter=U").stdout.split()
        if not conflicts:
            undo()
            return False, (r.stdout + r.stderr).strip()[:300], []
        patterns = (cfg.get("merge") or {}).get("auto_union") or []
        for f in conflicts:
            if not any(fnmatch.fnmatch(f, pat) for pat in patterns):
                undo()
                return False, f"conflict in {f} is not safe to union", conflicts
            with tempfile.TemporaryDirectory() as tmp:
                parts = []
                for n, stage in enumerate((2, 1, 3)):
                    path = os.path.join(tmp, str(n))
                    g = git("show", f":{stage}:{f}")
                    with open(path, "w") as fh:
                        fh.write(g.stdout if g.returncode == 0 else "")
                    parts.append(path)
                mf = subprocess.run(["git", "merge-file", "--union", "-p", *parts], capture_output=True, text=True)
                if mf.returncode < 0 or mf.returncode == 255:
                    undo()
                    return False, f"could not union {f}", conflicts
                target = os.path.join(tmp, "out" + os.path.splitext(f)[1])
                with open(target, "w") as fh:
                    fh.write(mf.stdout)
                check = (["python3", "-m", "py_compile", target] if f.endswith(".py")
                         else ["node", "--check", target] if f.endswith(".js") else None)
                if check and subprocess.run(check, capture_output=True).returncode != 0:
                    undo()
                    return False, f"union of {f} does not parse", conflicts
                shutil.copyfile(target, os.path.join(worktree, f))
            git("add", "--", f)
        c = git("commit", "--no-edit")
        if c.returncode != 0:
            undo()
            return False, (c.stdout + c.stderr).strip()[:300], conflicts
    test_command = test_command or project_test_command(cfg, repo, worktree)
    if test_command:
        try:
            t = subprocess.run(test_command, shell=True, cwd=worktree, capture_output=True, text=True, timeout=900)
            ok, tail = t.returncode == 0, (t.stdout + t.stderr).strip()[-300:]
        except subprocess.TimeoutExpired:
            ok, tail = False, "tests timed out"
        if not ok:
            undo()
            return False, f"tests failed after merging {base}: {tail}", conflicts
    return True, "merged " + base + (" (union: " + ", ".join(conflicts) + ")" if conflicts else ""), conflicts


def start_ready_tasks(cfg, m):
    """Start queued tasks whose dependencies are all merged, up to the mission's parallel limit.
    The worktree is cut from the repo's current HEAD, so it includes the merged work.
    Returns the started task records; the rest stay queued for a later call."""
    started, skipped = [], set()
    while True:
        data = m.read()
        tasks = data["tasks"]
        active = sum(t["state"] in ACTIVE_STATES for t in tasks.values())
        if active >= data.get("parallel", 3):
            break
        nxt = next((t for t in tasks.values() if t["state"] == "queued"
                    and t["id"] not in skipped
                    and all(tasks.get(d_, {}).get("state") == "merged" for d_ in t.get("depends_on", []))), None)
        if not nxt:
            break
        tid = nxt["id"]
        branch = f"{BRANCH_PREFIX}{slug(nxt['title'])}-{time.strftime('%m%d%H%M')}"
        deps = ", ".join(nxt.get("depends_on", []))
        msg = worker_msg(data["id"], nxt, branch) \
            + f"\n\nNote: this task was queued behind {deps}, which is merged into {data['base']}; your branch already includes it."
        try:
            d = start_agent(cfg, nxt.get("role", "worker"), data["repo"], msg, nxt["title"], branch=branch,
                            name=f"{tid}-{slug(nxt['title'], 20)}",
                            labels_extra={"drover.mission": data["id"], "drover.task-id": tid},
                            auto=bool(data.get("auto")), prefer_agent=nxt.get("agent_pref"), prefer_model=nxt.get("model_pref"))
        except SystemExit:
            d = {"agent": None}
        if not d.get("agent"):
            m.log("task", "drover", "coordinator", f"{tid} is ready ({deps} merged) but no agent could start it; left queued", task=tid, failed=True)
            skipped.add(tid)  # try the next ready task for the free slot
            continue
        now = int(time.time())
        info = {"state": "working", "agent": d["agent"], "model": d.get("model"), "family": d["family"],
                "machine": d["machine"], "address": d["address"], "branch": d["branch"], "worktree": d["cwd"],
                "updated": now, "created": now}

        def apply(x, tid=tid, info=info):
            x["tasks"][tid].update(info)
        m.update(apply)
        text = f"started queued {tid}: {d['agent']} on {d['machine']} ({deps} merged)"
        m.log("task", "drover", tid, text, task=tid)
        started.append({**nxt, **info, "fallback": d.get("fallback")})
    return started


MAP_SKIP = {".git", "node_modules", "__pycache__", ".venv", "venv", "dist", "build", "target", ".tox",
            ".mypy_cache", ".pytest_cache", ".next", ".cache", ".idea", ".hg", ".svn"}
PY_SYM = re.compile(r"^(?:async\s+def|def|class)\s+(\w+)")
JS_SYM = re.compile(r"^(?:export\s+(?:default\s+)?)?(?:async\s+)?(?:function\*?\s+(\w+)|class\s+(\w+)"
                    r"|(?:const|let|var)\s+(\w+)\s*=\s*(?:async\s*)?(?:function\b|\([^)]*\)\s*=>|\w+\s*=>))")
MAP_MAX_BYTES = 1_000_000


def file_symbols(path, text):
    first = text.split("\n", 1)[0]
    ext = os.path.splitext(path)[1].lower()
    if ext in (".py", ".pyw") or (not ext and first.startswith("#!") and "python" in first):
        rx, kind = PY_SYM, "py"
    elif ext in (".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx"):
        rx, kind = JS_SYM, "js"
    else:
        return []
    out = []
    for i, line in enumerate(text.split("\n"), 1):
        m_ = rx.match(line)
        if m_:
            name = next(g for g in m_.groups() if g)
            out.append(f"{'class ' if line.lstrip().startswith(('class', 'export class')) else ''}{name}:{i}")
    return out


def repo_map(root):
    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d_ for d_ in dirnames if d_ not in MAP_SKIP)
        for fn in sorted(f_ for f_ in filenames if f_ not in MAP_SKIP):
            full = os.path.join(dirpath, fn)
            rel = os.path.relpath(full, root)
            try:
                if os.path.islink(full) or os.path.getsize(full) > MAP_MAX_BYTES:
                    continue
                with open(full, "rb") as fh:
                    raw = fh.read()
            except OSError:
                continue
            if b"\0" in raw[:4096]:
                continue
            text = raw.decode("utf-8", "replace")
            files.append({"path": rel, "lines": text.count("\n") + (not text.endswith("\n") and bool(text)),
                          "symbols": file_symbols(rel, text)})
    return files


def cmd_map(a, cfg):
    root = os.path.abspath(os.path.expanduser(a.repo))
    if not os.path.isdir(root):
        die(f"{a.repo}: not a folder")
    files = repo_map(root)
    if a.json:
        print(json.dumps({"repo": root, "files": files}))
        return
    for f in files:
        print(f"{f['path']}  {f['lines']}")
        syms = f["symbols"]
        if syms:
            print("  " + " ".join(syms[:80]) + (f" … +{len(syms) - 80}" if len(syms) > 80 else ""))


def cmd_task(a, cfg):
    m = current_mission(a.mission)
    data = m.read()
    if a.action == "add":
        if not a.title:
            die("give the task a title")
        tid = f"t{data['next_task']}"
        brief = a.brief or a.title
        after = [x.strip() for x in (a.after or "").split(",") if x.strip()]
        for dep in after:
            dt = data["tasks"].get(dep)
            if not dt:
                die(f"--after {dep}: no such task in mission {data['id']}")
            if dt["state"] == "dropped":
                die(f"--after {dep}: that task was dropped")
        pref = {"prefer_agent": a.agent, "prefer_model": a.model}
        if a.model and not a.agent:
            die("--model needs --agent")
        files = parse_files(getattr(a, "files", None))
        for w in check_files(data["repo"], files):
            print(f"drover: warning: {w}", file=sys.stderr)
        done_ = [x.strip() for x in (getattr(a, "done", None) or []) if x.strip()]
        pack = {**({"files": files} if files else {}), **({"done": done_} if done_ else {}),
                **({"size": a.size} if getattr(a, "size", None) else {})}
        if after and any(data["tasks"][dep]["state"] != "merged" for dep in after):
            task = {"id": tid, "title": a.title, "brief": brief, "role": a.role, "state": "queued", "depends_on": after,
                    "agent": a.agent, "model": a.model, "agent_pref": a.agent, "model_pref": a.model, **pack,
                    "created": int(time.time()), "updated": int(time.time())}

            def queue(x):
                x["tasks"][tid] = task
                x["next_task"] += 1
            m.update(queue)
            m.log("task", "coordinator", tid, f"{a.title} (queued after {', '.join(after)})", task=tid)
            emit(task, a.json, lambda t: f"{t['id']}: queued until {', '.join(after)} are merged")
            return
        msg = None  # filled once the branch is known

        branch = f"{BRANCH_PREFIX}{slug(a.title)}-{time.strftime('%m%d%H%M')}"
        msg = worker_msg(data["id"], {"id": tid, "title": a.title, "brief": brief, **pack}, branch)
        d = start_agent(cfg, a.role, data["repo"], msg, a.title, branch=branch, name=f"{tid}-{slug(a.title, 20)}",
                        labels_extra={"drover.mission": data["id"], "drover.task-id": tid},
                        auto=bool(data.get("auto")), **pref)
        if not d["agent"]:
            emit(d, a.json, fmt_route)
            sys.exit(3)
        task = {"id": tid, "title": a.title, "brief": brief, "role": a.role, "state": "working", **pack,
                **({"depends_on": after} if after else {}),
                **({"agent_pref": a.agent, "model_pref": a.model} if a.agent else {}),
                "agent": d["agent"], "model": d.get("model"), "family": d["family"], "machine": d["machine"],
                "address": d["address"], "branch": d["branch"], "worktree": d["cwd"],
                "created": int(time.time()), "updated": int(time.time())}

        def add(x):
            x["tasks"][tid] = task
            x["next_task"] += 1
        m.update(add)
        m.log("task", "coordinator", tid, a.title, task=tid)
        task["fallback"] = d.get("fallback")
        emit(task, a.json, lambda t: f"{t['id']}: {t['agent']} on {t['machine']}, branch {t['branch']}"
             + (f"\n  note: {t['fallback']}" if t.get("fallback") else ""))
        return

    t = data["tasks"].get(a.id)
    if not t:
        die(f"no task {a.id} in mission {data['id']}")

    def set_task(**kw):
        def update(x):
            current = x["tasks"][a.id]
            if current["state"] == "dropped" and kw.get("state") != "dropped":
                die(f"task {a.id} was dropped: {current.get('reason', '')}")
            current.update({**kw, "updated": int(time.time())})
        m.update(update)

    if t["state"] == "dropped" and a.action != "drop":
        die(f"task {a.id} was dropped: {t.get('reason', '')}")
    if a.action == "drop":
        if not a.text.strip():
            die("give a reason for dropping the task")
        warnings = []
        queued = t["state"] == "queued"  # never started: no branch, worktree or agent
        repo = remote_path(cfg, data["repo"], t["machine"]) if not queued else None

        def git(*args):
            argv = ["git", "-C", repo, *args]
            if t["machine"] == local_name():
                r = subprocess.run(argv, capture_output=True, text=True)
                return r.returncode, r.stdout, r.stderr
            return remote_sh(hc_target(t["machine"]), shlex.join(argv))

        if queued:
            unmerged, code = None, 0
        else:
            code, out, err = git("rev-list", "--count", f"{data['base']}..{t['branch']}")
            unmerged = int(out.strip()) if code == 0 else None
        if unmerged:
            warnings.append(f"{t['branch']} has {unmerged} commits not in {data['base']}; removing without merging")
        elif code:
            warnings.append(f"could not check commits against {data['base']}: {(err or out).strip()}")
        # Mark dropped before killing agents so late reports cannot revive the task.
        set_task(state="dropped", reason=a.text)
        records = [] if queued else [t, *t.get("review_history", []), t.get("review") or {}]
        for addr in dict.fromkeys(r.get("address") for r in records):
            if addr:
                code, out, err = hc(["kill", addr])
                if code and not GONE.search(err + out):
                    warnings.append(f"could not kill {addr}: {(err or out).strip()}")
        for args in (() if queued else (("worktree", "remove", "--force", t["worktree"]), ("branch", "-D", t["branch"]))):
            code, out, err = git(*args)
            if code:
                warnings.append(f"cleanup failed ({shlex.join(args)}): {(err or out).strip()}")
        m.log("drop", "coordinator", a.id, a.text, task=a.id, unmerged_commits=unmerged, warnings=warnings)
        for warning in warnings:
            print(f"drover: warning: {warning}", file=sys.stderr)
        waiting = [tid for tid, x in m.read()["tasks"].items() if x["state"] == "queued" and a.id in x.get("depends_on", [])]
        if waiting:
            note = (f"{a.id} was dropped; queued {', '.join(waiting)} depend on it and stay queued. "
                    f"Drop them or re-plan (drover task drop <id> \"<reason>\" --mission {data['id']}).")
            m.log("drop", "drover", "coordinator", note, task=a.id)
            hc_send(data["coordinator"]["address"], f"[drover] mission {data['id']}: {note}")
        start_ready_tasks(cfg, m)  # a dropped task frees a slot
        emit({"task": a.id, "state": "dropped", "reason": a.text, "unmerged_commits": unmerged,
              "warnings": warnings}, a.json,
             lambda d: f"{a.id} dropped: {a.text}; " + ("cleanup completed with warnings" if warnings else "nothing to clean up" if queued else "branch and worktree removed")
             + "".join(f"\n  warning: {w}" for w in warnings))
        return
    if a.action == "reroute":
        role = "reviewer" if a.review else "worker"
        if a.model and not a.agent:
            die("--model needs --agent")
        if t["state"] not in ROLE_TASK_STATES[role]:
            die(f"{a.id} is {t['state']}; only {'/'.join(ROLE_TASK_STATES[role])} tasks can be rerouted"
                + ("" if a.review else " (use --review for its review)"))
        rec = t if role == "worker" else (t.get("review") or {})
        if not rec.get("address"):
            die(f"{a.id} has no {role} to move")
        if a.agent and a.agent == rec.get("agent") and not a.force:
            die(f"{a.id} is already on {a.agent}")
        if a.agent and not a.force:
            why, _ = agent_standing(cfg, a.agent, t["machine"], machine_tools(cfg, t["machine"]))
            if why:
                die(f"{a.agent} can't take {a.id} on {t['machine']}: {why} (--force to override)")
        if not a.agent:  # check first: the old agent is killed before the new one starts
            probe = route(cfg, "reviewer" if a.review else t.get("role", "worker"), (t["family"],) if a.review else (),
                          machine=t["machine"], skip_agent=rec.get("agent"))
            if not probe["agent"]:
                die(f"no other agent in the chain has capacity on {t['machine']}")
        new = reroute_task(cfg, m, a.id, role, a.reason or "moved by request", prefer_agent=a.agent,
                           prefer_model=a.model, force=a.force, manual=True)
        if not new:
            die(f"could not move {a.id}: see the log")
        emit({"task": a.id, "role": role, **new}, a.json,
             lambda d: f"{d['task']} {role} moved from {rec.get('agent')} to {d['agent']} ({d['address']})")
        return
    if a.action == "done":
        set_task(state="done", summary=a.text)
        e = m.log("done", a.id, "coordinator", a.text or "done", task=a.id)
        hc_send(data["coordinator"]["address"], f"[drover] mission {data['id']}: {a.id} done: {e['text']}\nNext: drover task review {a.id} --mission {data['id']}")
        started = start_ready_tasks(cfg, m)
        emit({"task": a.id, "state": "done", "started": started}, a.json,
             lambda d: f"{d['task']} done; the coordinator knows"
             + "".join(f"\n  started queued {s['id']}: {s['agent']} on {s['machine']}" for s in d["started"]))
        return
    if a.action == "review":
        if a.model and not a.agent:
            die("--model needs --agent")
        msg = reviewer_msg(data, t)
        # The reviewer reads the worktree, so it runs on the worker's machine.
        started = int(time.time())
        d = start_agent(cfg, "reviewer", data["repo"], msg, f"review {t['title']}", avoid=(t["family"],),
                        machine=t["machine"], cwd=t["worktree"], branch=t["branch"], name=f"rev-{a.id}-{slug(t['title'], 16)}",
                        labels_extra={"drover.mission": data["id"], "drover.task-id": a.id}, auto=bool(data.get("auto")),
                        prefer_agent=a.agent, prefer_model=a.model)
        if not d["agent"]:
            emit(d, a.json, fmt_route)
            sys.exit(3)
        history = list(t.get("review_history", []))
        if t.get("review"):
            history.append(t["review"])
        set_task(state="review", review_history=history,
                 review={"address": d["address"], "agent": d["agent"], "model": d.get("model"),
                         "family": d["family"], "machine": d["machine"], "verdict": None, "started": started})
        m.log("review", "coordinator", f"review:{a.id}", f"review {t['branch']}", task=a.id)
        emit({"task": a.id, "reviewer": d["agent"], "address": d["address"], "fallback": d.get("fallback")}, a.json,
             lambda x: f"{a.id}: {x['reviewer']} reviews it ({x['address']})"
             + (f"\n  note: {x['fallback']}" if x.get("fallback") else ""))
        return
    if a.action == "verdict":
        if a.verdict not in ("approve", "changes"):
            die("verdict is approve or changes")
        rv = dict(t.get("review") or {})
        rv["verdict"] = a.verdict
        set_task(state="approved" if a.verdict == "approve" else "changes", review=rv)
        e = m.log("verdict", f"review:{a.id}", "coordinator", a.text or a.verdict, task=a.id, verdict=a.verdict)
        nxt = (f"drover task merge {a.id} --mission {data['id']}" if a.verdict == "approve"
               else f"drover say {a.id} \"<the fixes>\" --mission {data['id']}")
        hc_send(data["coordinator"]["address"], f"[drover] mission {data['id']}: review of {a.id}: {a.verdict}\n{e['text']}\nNext: {nxt}")
        if rv.get("address"):  # the reviewer's job is done
            hc(["kill", rv["address"]])
        emit({"task": a.id, "verdict": a.verdict}, a.json, lambda d: f"{d['task']}: {d['verdict']} sent")
        return
    if a.action == "merge":
        repo = data["repo"]
        if t["machine"] != local_name():
            die(f"{a.id} is on {t['machine']}; merging work from other machines comes with handoff (not yet)")
        def try_merge():
            r = subprocess.run(["git", "-C", repo, "merge", "--no-ff", "--no-edit", "-m",
                                f"Merge {t['branch']}: {t['title']}", t["branch"]], capture_output=True, text=True)
            if r.returncode != 0:
                subprocess.run(["git", "-C", repo, "merge", "--abort"], capture_output=True)
            return r
        r = try_merge()
        if r.returncode != 0:
            why = (r.stdout + r.stderr).strip()
            m.log("merge", "coordinator", a.id, f"merge failed: {why[:300]}; trying to auto-resolve", task=a.id, failed=True)
            ok, detail, files = auto_resolve_merge(cfg, repo, data["base"], t["worktree"], getattr(a, "test_command", None))
            if ok:
                r = try_merge()
                if r.returncode == 0:
                    m.log("merge", "coordinator", a.id, f"auto-resolved: {detail}", task=a.id)
            if not ok or r.returncode != 0:
                if ok:
                    detail, files = (r.stdout + r.stderr).strip()[:300], []
                set_task(state="changes")
                listing = ", ".join(files) if files else "(see detail)"
                nxt = (f"merge {data['base']} into your branch in your worktree, resolve the conflicts, run the tests, "
                       f"commit, then: drover task done {a.id} \"<summary>\"")
                text = (f"[drover] mission {data['id']}: merging {a.id} into {data['base']} conflicts and could not be "
                        f"auto-resolved: {detail}\nConflicting files: {listing}\nNext: {nxt}")
                m.log("merge", "coordinator", a.id, f"merge failed, sent back to worker: {detail}", task=a.id, failed=True)
                for addr in (t.get("address"), data["coordinator"]["address"]):
                    if addr:
                        hc_send(addr, text)
                die(f"merge of {t['branch']} failed (aborted); {a.id} is back in 'changes': {detail}")
        for addr in (t.get("address"), (t.get("review") or {}).get("address")):
            if addr:
                hc(["kill", addr])
        subprocess.run(["git", "-C", repo, "worktree", "remove", "--force", t["worktree"]], capture_output=True)
        subprocess.run(["git", "-C", repo, "branch", "-D", t["branch"]], capture_output=True)
        set_task(state="merged")
        m.log("merge", "coordinator", a.id, f"merged {t['branch']} into {data['base']}", task=a.id)
        started = start_ready_tasks(cfg, m)
        emit({"task": a.id, "merged": t["branch"], "started": started}, a.json,
             lambda d: f"merged {d['merged']}; branch and worktree removed"
             + "".join(f"\n  started queued {s['id']}: {s['agent']} on {s['machine']}, branch {s['branch']}" for s in d["started"]))


