    s.add_argument("--mission", help="only this mission (default: all running)")
    s.add_argument("--once", action="store_true")
    s.add_argument("--interval", type=int, default=60)
    s = add("cleanup", cmd_cleanup, "remove merged drover/* branches and their worktrees")
    s.add_argument("--repo", default=".")
    s.add_argument("--machine")
    s.add_argument("--yes", action="store_true", help="really remove (default: show what would go)")

    a = p.parse_args()
    if a.cmd == "task":  # positional shapes differ per action
        if a.action == "add":
            a.title, a.text = " ".join([a.id, *a.rest]).strip(), ""
        elif a.action == "verdict":
            a.verdict = a.rest[0] if a.rest else ""
            a.text = " ".join(a.rest[1:])
        else:
            a.text = " ".join(a.rest)
