def build_argv(agent, model, task, repo="", *, auto=False):
    argv, skip = [], False
    # Configured auto_args always apply (as before); the built-in defaults only for an auto mission.
    # An empty configured list switches the flags off.
    auto_args = agent["auto_args"] if "auto_args" in agent else (agent.get("default_auto_args", []) if auto else [])
    tpl = list(agent["argv"])
    if auto_args and "{task}" in tpl:
        # Right after the binary, so a prompt flag such as Copilot's -i stays next to its value.
        tpl[1:1] = auto_args
    tpl = [p.replace("{repo}", repo) for p in tpl]
    for i, part in enumerate(tpl):
        if skip:
            skip = False
            continue
        nxt = tpl[i + 1] if i + 1 < len(tpl) else None
        if nxt == "{model}" and not model:
            skip = True  # drop the flag and its value
            continue
        argv.append(part.replace("{model}", model or "").replace("{task}", task))
    return [a for a in argv if a != ""]


def route(cfg, role, families_to_avoid=(), repo=None, machine=None, prefer_agent=None, prefer_model=None,
          prefer_force=False, skip_agent=None):
    """Pick (agent, model, machine) for a role. Returns a decision with the
    reasons every rejected option was skipped, so the panel can show why.
    `prefer_agent` is tried before the role's chain (falling back to it when that
    agent is out of capacity or not installed); a reviewer still can't share the
    author's family. `prefer_force` takes the preferred agent without the capacity and install checks;
    `skip_agent` leaves one agent out of the chain (moving a task off it)."""
    r = cfg["roles"].get(role)
    if not r:
        die(f"unknown role {role!r} (have: {', '.join(cfg['roles'])})")
    chain = [c for c in r["chain"] if c["agent"] != skip_agent]
    if prefer_agent:
        pa = cfg["agents"].get(prefer_agent)
        if not pa:
            die(f"unknown agent {prefer_agent!r} (have: {', '.join(cfg['agents'])})")
        if r.get("other_family") and pa["family"] in families_to_avoid:
            die(f"{prefer_agent} is the same model family ({pa['family']}) as the author; a reviewer must be from another family")
        chain = [{"agent": prefer_agent, "model": prefer_model}] + [c for c in chain if c["agent"] != prefer_agent]
    data = fleet(cfg)
    running = {}
    for t in drover_terminals():
        if labels(t).get("drover.role") == "watcher":  # not an agent: never counts against max_agents
            continue
        running[machine_of(t["address"])] = running.get(machine_of(t["address"]), 0) + 1
    pl = cfg["placement"]
    prefer = r.get("prefer") or []
    rejected = []
    out = agents_out()

    def machine_ok(m):
        mc = machine_cfg(cfg, m["name"])
        if machine and m["name"] != machine:
            return "not the requested machine"
        if not m.get("online"):
            return m.get("error") or "offline"
        if not mc["enabled"]:
            return "disabled in settings"
        if r.get("durable") and not mc["durable"]:
            return "not a durable host"
        if pl.get("avoid_battery") and m.get("power") == "battery":
            return "on battery"
        if m.get("disk_free_gb") is not None and m["disk_free_gb"] < pl.get("min_disk_gb", 0):
            return f"only {m['disk_free_gb']} GB free"
        if running.get(m["name"], 0) >= mc["max_agents"]:
            return f"full ({running.get(m['name'], 0)}/{mc['max_agents']} agents)"
        return None

    def rank(m):
        # Preferred machines first, in their order; then the least loaded per CPU.
        pref = prefer.index(m["name"]) if m["name"] in prefer else len(prefer)
        busy = (m.get("load") or 0) / max(m.get("cpus") or 1, 1) + running.get(m["name"], 0)
        return (pref, busy)

    ok_machines = []
    for m in data["machines"]:
        why = machine_ok(m)
        if why:
            rejected.append({"machine": m["name"], "why": why})
        else:
            ok_machines.append(m)
    # Only machines that have the project checked out.
    if repo:
        def has_repo(m):
            path = remote_path(cfg, repo, m["name"])
            if m["name"] == local_name():
                return os.path.isdir(os.path.join(path, ".git")) or os.path.isfile(os.path.join(path, ".git"))
            code, out, err = remote_sh(hc_target(m["name"]), f"[ -e {shlex.quote(path)}/.git ] && echo yes=1", timeout=20)
            return "yes=1" in out
        with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
            have = list(pool.map(has_repo, ok_machines))
        for m, ok in zip(list(ok_machines), have):
            if not ok:
                ok_machines.remove(m)
                rejected.append({"machine": m["name"], "why": "project not checked out there"})
    ok_machines.sort(key=rank)

    # Proactive quota. usage_probe reads how full an agent's plan window is before it runs out.
    # Rule 1: at or above avoid_above_percent the agent counts as out on that machine until its window
    # resets (mark_out, so every later route sees it too). Rule 2 (prefer_headroom): chain order still
    # wins, except that a choice at or above headroom_percent is only a fallback: the first later choice
    # that is KNOWN to be below headroom_percent replaces it. Unknown usage never beats a known-high one.
    q = cfg.get("quota") or {}
    avoid_at = q.get("avoid_above_percent") or 0
    headroom_at = (q.get("headroom_percent") or 0) if q.get("prefer_headroom") else 0
    tight = None  # first viable choice above the headroom line

    def finish(dec):
        if prefer_agent and dec["agent"] != prefer_agent:
            why = "; ".join(x["why"] for x in rejected if x.get("agent") == prefer_agent) or "unavailable"
            dec["fallback"] = f"{prefer_agent} unavailable ({why}); used {dec['agent']} from the {role} chain"
        return dec

    for choice in chain:
        agent = cfg["agents"].get(choice["agent"])
        if not agent:
            rejected.append({"agent": choice["agent"], "why": "no such agent in settings"})
            continue
        if r.get("other_family") and agent["family"] in families_to_avoid:
            rejected.append({"agent": choice["agent"], "why": f"same family as the author ({agent['family']})"})
            continue
        forced = bool(prefer_force and choice["agent"] == prefer_agent)
        o = None if forced else out.get(CAPACITY_ALIASES.get(choice["agent"], choice["agent"]))
        if o and not o.get("machine"):
            rejected.append({"agent": choice["agent"], "why": f"out of capacity until {fmt_until(o['until'])} ({o['reason']})"})
            continue
        for m in ok_machines:
            if o and o.get("machine") == m["name"]:
                rejected.append({"agent": choice["agent"], "machine": m["name"],
                                 "why": f"out of capacity until {fmt_until(o['until'])} ({o['reason']})"})
                continue
            if not forced and agent["bin"] not in m.get("tools", []):
                rejected.append({"agent": choice["agent"], "machine": m["name"], "why": f"{agent['bin']} not installed"})
                continue
            u = usage_probe(choice["agent"], hc_target(m["name"])) if (avoid_at or headroom_at) and not forced else None
            if u and avoid_at and u["used_percent"] >= avoid_at and u["resets_at"] > time.time():
                why = f"used {u['used_percent']:.0f}% of {u['window']} window"
                mark_out(choice["agent"], u["resets_at"], why, machine=m["name"])
                rejected.append({"agent": choice["agent"], "machine": m["name"],
                                 "why": f"out of capacity until {fmt_until(u['resets_at'])} ({why})"})
                continue
            decision = {"role": role, "agent": choice["agent"], "model": choice.get("model"),
                        "family": agent["family"], "machine": m["name"], "rejected": rejected}
            if headroom_at and u and u["used_percent"] >= headroom_at:
                if prefer_agent and choice["agent"] == prefer_agent:
                    # an explicit choice only yields to hard limits: note the headroom, keep it
                    decision["note"] = (f"{prefer_agent} has used {u['used_percent']:.0f}% of its {u['window']} "
                                        f"window (above {headroom_at}% headroom); kept because it was asked for")
                    return finish(decision)
                tight = tight or (decision, u)
                continue
            if tight and not (u and headroom_at):  # unknown usage is no headroom
                continue
            if tight:
                first, fu = tight
                rejected.append({"agent": first["agent"], "machine": first["machine"],
                                 "why": f"used {fu['used_percent']:.0f}% of {fu['window']} window "
                                        f"(above {headroom_at}% headroom); {choice['agent']} has headroom"})
            return finish(decision)
    if tight:
        return finish(tight[0])
    return {"role": role, "agent": None, "machine": None, "rejected": rejected}


def remote_path(cfg, repo, machine):
    """The same project on another machine: a path under ~ maps to that
    machine's home; anything else is used as given."""
    repo = os.path.abspath(os.path.expanduser(repo))
    if machine == local_name():
        return repo
    home = next((m.get("home") for m in fleet(cfg)["machines"] if m["name"] == machine), None)
    if home and (repo == HOME or repo.startswith(HOME + os.sep)):
        return home + repo[len(HOME):]
    return repo


def slug(text, n=24):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return s[:n].strip("-") or "task"


