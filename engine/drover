DEAD_STATES = ("exited", "finished", "dead", "closed", "gone", "stopped")
MAX_REROUTES = 5
ROLE_TASK_STATES = {"worker": ("working", "changes"), "reviewer": ("review",)}


def probe_agent(address, agent, lines=60):
    """What is this agent's terminal doing? -> {"gone": bool, "status": str, "screen": str},
    or None when hc cannot say (never read as gone)."""
    code, out, err = hc(["get", address, "--json"], timeout=20)
    if code != 0:
        return {"gone": True, "status": "", "screen": ""} if GONE.search(err + out) else None
    try:
        t = json.loads(out)
        t = t.get("terminal", t)
    except (json.JSONDecodeError, AttributeError):
        return None
    if (t.get("state") or "live") in DEAD_STATES:
        return {"gone": True, "status": t.get("status") or "", "screen": ""}
    code, screen, err = hc(["read", address, "--lines", str(lines)], timeout=20)
    return {"gone": False, "status": t.get("status") or "", "screen": screen if code == 0 else ""}


def stuck_reason(cfg, data, status, record, now):
    """Why a live agent counts as stuck, or None. Only errors, and (auto missions only, since
    otherwise a blocked agent waits for the person) a long block."""
    if status == "error":
        return "its status is error"
    minutes = cfg.get("missions", {}).get("stuck_minutes", 20)
    if status == "blocked" and data.get("auto") and minutes:
        since = record.get("blocked_since")
        if since and now - since >= minutes * 60:
            return f"blocked for {int((now - since) // 60)} minutes"
    return None


def agent_standing(cfg, agent, machine, tools=None, out=None, now=None):
    """(why not, usage): why an agent can't take work on a machine now (out of capacity, not installed,
    plan window above avoid_above_percent), or None; plus its usage reading when known."""
    now = time.time() if now is None else now
    a = cfg["agents"].get(agent)
    if not a:
        return "no such agent in settings", None
    o = (agents_out(now) if out is None else out).get(CAPACITY_ALIASES.get(agent, agent))
    if o and o.get("machine") in (None, machine):
        return f"out of capacity until {fmt_until(o['until'], now)} ({o.get('reason')})", None
    if tools is not None and a["bin"] not in tools:
        return f"{a['bin']} not installed", None
    u = usage_probe(agent, hc_target(machine), now) if machine else None
    avoid_at = (cfg.get("quota") or {}).get("avoid_above_percent") or 0
    if u and avoid_at and u["used_percent"] >= avoid_at and u["resets_at"] > now:
        return f"used {u['used_percent']:.0f}% of {u['window']} window, resets {fmt_until(u['resets_at'], now)}", u
    return None, u


def machine_tools(cfg, machine):
    """The agent binaries installed on a machine, or None when the fleet doesn't say."""
    try:
        return next((x.get("tools", []) for x in fleet(cfg)["machines"] if x["name"] == machine), None)
    except Exception:
        return None


def task_alternatives(cfg, t, role, tools, out, now):
    """Chain agents with capacity on the task's machine, for a 'Move to...' picker; a reviewer's
    exclude the worker's family."""
    rec = t if role == "worker" else (t.get("review") or {})
    rname = "reviewer" if role == "reviewer" else t.get("role", "worker")
    rows = []
    for c in (cfg["roles"].get(rname) or {}).get("chain", []):
        a = cfg["agents"].get(c["agent"])
        if not a or c["agent"] == rec.get("agent") or (role == "reviewer" and a["family"] == t.get("family")):
            continue
        why, u = agent_standing(cfg, c["agent"], t.get("machine"), tools, out, now)
        if not why:
            rows.append({"agent": c["agent"], "model": c.get("model"), "family": a["family"],
                         "used_percent": u["used_percent"] if u else None, "resets_at": u["resets_at"] if u else None})
    return rows


def reroute_task(cfg, m, tid, role, why, now=None, *, prefer_agent=None, prefer_model=None, force=False, manual=False):
    """Move a task's worker (or reviewer) to the next choice in the role's chain, on the same
    machine, branch and worktree. Returns the new record, or None when nothing is left.
    prefer_agent/prefer_model pick the agent (force: even if out or not installed); manual
    (the reroute command) also skips the already-reported guard and leaves the current agent out."""
    now = int(time.time() if now is None else now)
    data = m.read()
    t = data["tasks"][tid]
    rec = t if role == "worker" else (t.get("review") or {})
    old_addr, old_agent = rec.get("address"), rec.get("agent")
    tried = rec.get("reroute_failed") or {}
    out_now = sorted(agents_out())
    if tried and not manual and tried.get("address") == old_addr and tried.get("out") == out_now:
        return None  # already reported; nothing changed since
    if t.get("reroutes", 0) >= MAX_REROUTES:
        return _reroute_failed(m, data, tid, role, rec, why, out_now, f"{tid} was moved {MAX_REROUTES} times already")
    if old_addr:
        hc(["kill", old_addr])
    note = (f"\n\nNote: a previous agent ({old_agent}) stopped here ({why}). You take over this worktree; "
            "it may hold uncommitted work, so check `git status` and `git diff` first and build on it.")
    if role == "worker":
        brief = worker_msg(data["id"], t, t["branch"]) + note
        title, name, avoid = t["title"], f"{tid}-{slug(t['title'], 20)}", ()
    else:
        brief = reviewer_msg(data, t) + note
        title, name, avoid = f"review {t['title']}", f"rev-{tid}-{slug(t['title'], 16)}", (t["family"],)
    try:
        d = start_agent(cfg, "reviewer" if role == "reviewer" else t.get("role", "worker"), data["repo"], brief, title,
                        avoid=avoid, machine=t["machine"], cwd=t["worktree"], branch=t["branch"], name=name,
                        labels_extra={"drover.mission": data["id"], "drover.task-id": tid}, auto=bool(data.get("auto")),
                        prefer_agent=prefer_agent, prefer_model=prefer_model, prefer_force=force,
                        skip_agent=old_agent if manual and not prefer_agent else None)
    except SystemExit:
        d = {"agent": None}
    if not d.get("agent"):
        return _reroute_failed(m, data, tid, role, rec, why, out_now, "no agent is left in the chain")
    new = {"address": d["address"], "agent": d["agent"], "model": d.get("model"), "family": d["family"]}

    def apply(x):
        cur = x["tasks"][tid]
        cur["reroutes"] = cur.get("reroutes", 0) + 1
        cur["updated"] = now
        if role == "worker":
            cur.update(new)
            cur.pop("blocked_since", None)
            cur.pop("reroute_failed", None)
        else:
            hist = list(cur.get("review_history", []))
            hist.append(cur.get("review") or {})
            cur["review_history"] = hist
            cur["review"] = {**new, "machine": cur["machine"], "verdict": None, "started": now}
    m.update(apply)
    text = f"{tid} moved from {old_agent} to {d['agent']} ({why})"
    m.log("reroute", "drover", "coordinator", text, task=tid, role=role, old=old_addr, new=d["address"])
    hc_send(data["coordinator"].get("address"), f"[drover] mission {data['id']}: {text}")
    return new


def _reroute_failed(m, data, tid, role, rec, why, out_now, reason):
    def apply(x):
        cur = x["tasks"][tid]
        target = cur if role == "worker" else cur.get("review")
        if target is not None:
            target["reroute_failed"] = {"address": rec.get("address"), "out": out_now}
    m.update(apply)
    text = f"{tid}: {rec.get('agent')} stopped ({why}) and {reason}; left as is"
    m.log("reroute", "drover", "coordinator", text, task=tid, role=role, failed=True)
    hc_send(data["coordinator"].get("address"), f"[drover] mission {data['id']}: {text}")
    return None


def check_mission(cfg, mission_id, now=None):
    """Look at every active worker and reviewer of a mission; mark out agents that ran out of
    capacity and move their tasks. Returns the list of what it did."""
    now = int(time.time() if now is None else now)
    m = Mission(mission_id)
    data = m.read()
    done = []
    if data.get("state") != "running":
        return done
    for tid, t in data.get("tasks", {}).items():
        for role, states in ROLE_TASK_STATES.items():
            if t.get("state") not in states:
                continue
            rec = t if role == "worker" else (t.get("review") or {})
            if not rec.get("address") or rec.get("verdict"):
                continue
            agent = rec.get("agent") or ""
            pr = probe_agent(rec["address"], agent)
            if pr is None:
                continue
            why = None
            hit = None
            if pr["gone"]:
                why = "its terminal exited"
            else:
                tail = "\n".join([l for l in pr["screen"].splitlines() if l.strip()][-25:])
                if pr["status"] != "working":  # a working agent may merely mention limits in its output
                    hit = detect_capacity(agent, tail, now)
                if hit:
                    mark_out(agent, hit[0], hit[1])
                    why = f"{hit[1]} until {fmt_until(hit[0], now)}"
                else:
                    if pr["status"] in ("idle", "blocked"):  # out of capacity already: move now, not on the screen text
                        gone_why = agent_standing(cfg, agent, rec.get("machine") or t.get("machine"), None, None, now)[0]
                        if gone_why and gone_why.startswith(("out of", "used ")):
                            why = gone_why
                    if pr["status"] == "blocked" and not rec.get("blocked_since"):
                        m.update(lambda x, tid=tid, role=role: (x["tasks"][tid] if role == "worker" else x["tasks"][tid]["review"]).update(blocked_since=now))
                        rec["blocked_since"] = now
                    elif pr["status"] != "blocked" and rec.get("blocked_since"):
                        m.update(lambda x, tid=tid, role=role: (x["tasks"][tid] if role == "worker" else x["tasks"][tid]["review"]).pop("blocked_since", None))
                    why = why or stuck_reason(cfg, data, pr["status"], rec, now)
            if why:
                new = reroute_task(cfg, m, tid, role, why, now)
                done.append({"task": tid, "role": role, "why": why, "moved": bool(new), "to": (new or {}).get("agent")})
    return done


COORD_WATCH = os.path.join(STATE_DIR, "coordinators.json")
COORD_MISSES = 2          # consecutive failed checks before a restart
COORD_MAX_RESTARTS = 3    # per repo per hour


def next_step(t):
    st, rv = t.get("state"), (t.get("review") or {}).get("verdict")
    if st == "done":
        return f"{t['id']} done: review it"
    if st == "review":
        return f"{t['id']} in review: wait for the verdict"
    if st == "approved":
        return f"{t['id']} approved: merge it"
    if st == "changes":
        return f"{t['id']} needs changes{' (' + rv + ')' if rv else ''}: its worker is on it"
    if st == "working":
        return f"{t['id']} working: wait for it"
    return None


def takeover_digest(m):
    """Everything a fresh coordinator needs to carry on one mission."""
    data = m.read()
    lines = [mission_digest(data)]
    for t in data.get("tasks", {}).values():
        if t.get("branch"):
            lines.append(f"    {t['id']} branch: {t['branch']}")
    log = [e for e in m.entries() if e.get("text")][-5:]
    if log:
        lines.append("    last log:")
        lines += [f"      {e.get('from')}->{e.get('to')}: {str(e['text'])[:120]}" for e in log]
    nxt = [n for n in map(next_step, data.get("tasks", {}).values()) if n]
    lines.append("    next: " + ("; ".join(nxt) if nxt else "plan the tasks, or finish the mission if the goal is met"))
    return "\n".join(lines)


def _coord_state():
    try:
        with open(COORD_WATCH) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


PROMPT_MARKERS = ">›→"   # Claude Code, Codex, Cursor
REPLY_MARKERS = "●•⏺"
COORD_FINISHED_HOURS = 24


def last_person_message(screen):
    """The person's last unanswered message on a coordinator's screen: the last non-empty user-input
    block (a line led by a Claude Code '>', Codex '›' or Cursor '→' prompt marker, plus its indented
    continuation lines). None when an agent reply follows it or there is none."""
    lines = (screen or "").splitlines()
    blocks = []  # (index after the block, text)
    for i, line in enumerate(lines):
        m = re.match(r"^\s*[│|]?\s*([" + PROMPT_MARKERS + r"])(?:\s(.*))?$", line.rstrip().rstrip("│|").rstrip())
        if not m:
            continue
        text = [(m.group(2) or "").strip()]
        j = i + 1
        while j < len(lines) and re.match(r"^\s{2,}\S", lines[j]) and lines[j].lstrip()[0] not in "─━":
            text.append(lines[j].strip())
            j += 1
        blocks.append((j, " ".join(x for x in text if x).strip()))
    for end, text in reversed(blocks):
        if not text:
            continue
        if any(l.lstrip()[:1] in REPLY_MARKERS for l in lines[end:] if l.strip()):
            return None
        return text
    return None


def hand_over_coordinator(cfg, repo, old, why, *, alive=True, agent=None, model=None, force=False, now=None):
    """Start one new coordinator for a repo (honouring capacity; `agent` first, then the role's chain),
    brief it with every running mission (else the newest finished one) and the person's last unanswered
    message, record it on all the repo's missions and kill the old terminal. Returns the new record, or None."""
    now = int(time.time() if now is None else now)
    rows = [r for r in mission_rows(repo, cfg) if not r["archived"]]
    if not rows:
        die(f"no missions for {tilde(repo)}")
    ms = [Mission(r["id"]) for r in rows]
    nd = ms[0].read()
    digest = [m for m in ms if m.read()["state"] == "running"] or ms[:1]
    old = old or {}
    screen = ""
    if alive and old.get("address"):
        code, screen, _ = hc(["read", old["address"], "--lines", "80"], timeout=20)
        screen = screen if code == 0 else ""
        tail = "\n".join([l for l in screen.splitlines() if l.strip()][-25:])
        hit = detect_capacity(old.get("agent") or "", tail, now)
        if hit:
            mark_out(old.get("agent") or "", hit[0], hit[1])
    brief = COORDINATOR_BRIEF.format(mid=nd["id"], repo=tilde(repo), goal=nd["goal"], parallel=nd.get("parallel", 3),
                                     extra=mission_extras(nd))
    brief += ("\n\nThe previous coordinator stopped (" + why + "). You take over every running mission "
              "(pass each one's own --mission id). Where each stands:\n" + "\n".join(takeover_digest(m) for m in digest))
    pending = last_person_message(screen)
    if pending:
        brief += ("\n\nThe person's last message to the previous coordinator is still unanswered. Answer it first:\n"
                  "> " + pending)
    extra = {"drover.repo": nd["repo"]}
    if nd.get("space"):
        extra.update({"herdr.space": nd["space"], "herdr.tab": coordinator_tab(nd["repo"])})
    try:
        d = start_agent(cfg, "coordinator", nd["repo"], brief, nd["goal"], labels_extra=extra, auto=bool(nd.get("auto")),
                        name=f"coord-{slug(os.path.basename(repo), 16)}-{time.strftime('%m%d%H%M')}",
                        prefer_agent=agent, prefer_model=model, prefer_force=force)
    except SystemExit:
        d = {"agent": None}
    if not d.get("agent"):
        return None
    if alive and old.get("address"):
        hc(["kill", old["address"]])
    new = {"address": d["address"], "agent": d["agent"], "model": d.get("model"),
           "family": d["family"], "machine": d["machine"], "started": now}
    frm = old.get("agent") or old.get("address") or "none"
    to = d["agent"] + (f"/{d['model']}" if d.get("model") else "")
    for m in ms:
        m.update(lambda x: x.update({"coordinator": new}))
        m.log("mission", "drover", "coordinator", f"coordinator handed over from {frm} to {to} ({why})")
    return new


def check_coordinators(cfg, now=None):
    """Per repo with running missions (or whose newest mission finished less than a day ago): when the
    coordinator's terminal is gone (or it is out of capacity) on two consecutive checks, start one new
    coordinator with a digest of every running mission. A finished mission's coordinator is only replaced
    when it is out of capacity with a message from the person waiting. At most COORD_MAX_RESTARTS an hour
    per repo. Inconclusive checks do nothing."""
    now = int(time.time() if now is None else now)
    repos = {}
    for m in running_missions():
        repos.setdefault(os.path.realpath(m.read()["repo"]), []).append(m)
    finished, seen = set(), set()
    for r in mission_rows(cfg=cfg):  # newest first
        real = os.path.realpath(r["repo"])
        if real in seen or real in repos:
            continue
        seen.add(real)
        if r["archived"] or r["state"] == "running":
            continue
        if now - (Mission(r["id"]).read().get("done_at") or r.get("updated") or 0) < COORD_FINISHED_HOURS * 3600:
            repos[real] = [Mission(r["id"])]
            finished.add(real)
    try:
        terminals = drover_terminals(strict=True)
    except Inconclusive:
        return []
    state, done = _coord_state(), []
    for repo, ms in repos.items():
        datas = [m.read() for m in ms]
        coord = next((x["coordinator"] for x in datas if (x.get("coordinator") or {}).get("address")), None)
        if not coord:
            continue
        st = state.setdefault(repo, {"misses": 0, "restarts": []})
        st["restarts"] = [t for t in st.get("restarts", []) if now - t < 3600]
        t = next((t for t in terminals if same_address(t.get("address"), coord["address"])), None)
        why = None
        if t is None or (t.get("state") or "live") in DEAD_STATES:
            if repo not in finished:
                why = "its terminal exited"
        elif t.get("status") != "working":
            code, screen, _ = hc(["read", coord["address"], "--lines", "60"], timeout=20)
            screen = screen if code == 0 else ""
            tail = "\n".join([l for l in screen.splitlines() if l.strip()][-25:])
            hit = detect_capacity(coord.get("agent") or "", tail, now)
            if hit and (repo not in finished or last_person_message(screen)):
                why = f"{hit[1]} until {fmt_until(hit[0], now)}"
        if not why:
            st["misses"] = 0
            continue
        st["misses"] = st.get("misses", 0) + 1
        if st["misses"] < COORD_MISSES:
            continue
        if len(st["restarts"]) >= COORD_MAX_RESTARTS:
            if not st.get("limit_logged"):
                st["limit_logged"] = True
                for m in ms:
                    m.log("mission", "drover", "person", f"coordinator is gone ({why}) and was restarted "
                          f"{COORD_MAX_RESTARTS} times in the last hour; not restarting again, start one yourself")
                done.append({"repo": repo, "restarted": False, "why": "restart limit"})
            continue
        new = hand_over_coordinator(cfg, repo, coord, why, alive=t is not None, now=now)
        st["restarts"].append(now)
        st["misses"] = 0
        st.pop("limit_logged", None)
        if not new:
            done.append({"repo": repo, "restarted": False, "why": "no agent available"})
            continue
        done.append({"repo": repo, "restarted": True, "why": why, "to": new["address"]})
    write_json(COORD_WATCH, state)
    return done


def cmd_watch(a, cfg):
    idle = 0
    while True:
        try:
            missions = [Mission(a.mission)] if a.mission else running_missions()
            results = {}
            if not a.mission:
                restarted = check_coordinators(cfg)
                if restarted:
                    results["coordinators"] = restarted
            for m in missions:
                acts = check_mission(cfg, m.read()["id"])
                if acts:
                    results[m.read()["id"]] = acts
            if results and not a.json:
                print(json.dumps(results), flush=True)
            idle = 0 if missions else idle + 1
        except Exception as e:  # one bad pass must not end the watcher
            print(f"drover watch: {e}", file=sys.stderr, flush=True)
        if a.once:
            emit({"checked": [m.read()["id"] for m in missions], "actions": results}, a.json, lambda d: json.dumps(d["actions"]) if d["actions"] else "nothing to do")
            return
        if idle * a.interval >= 600:  # no running missions for 10 minutes; mission start launches a new one
            return
        time.sleep(a.interval)


def ensure_watcher(cfg):
    """One watcher per machine that holds mission state: a kept hc terminal labelled
    drover.role=watcher, started once (idempotent). Failures only warn."""
    try:
        for t in drover_terminals(strict=True):
            if labels(t).get("drover.role") == "watcher" and machine_of(t["address"]) == local_name() \
                    and (t.get("state") or "live") not in DEAD_STATES:
                return t["address"]
        args = ["run", "--bg", "--json", "--cwd", HOME, "--name", "drover-watcher", "--keep",
                "--label", "drover.role=watcher"]
        if not os.environ.get("HC_TERMINAL_ID"):
            args.append("--no-parent")
        code, out, err = hc([*args, "--", sys.executable, os.path.abspath(__file__), "watch"], timeout=60)
        if code != 0:
            raise RuntimeError(err.strip() or out.strip())
        return "started"
    except (Inconclusive, RuntimeError, OSError) as e:
        print(f"drover: warning: could not start the watcher ({e}); run `drover watch` yourself", file=sys.stderr)


def cmd_coordinator(a, cfg):
    repo = os.path.realpath(os.path.expanduser(a.repo))
    rows = [r for r in mission_rows(repo, cfg) if not r["archived"]]
    if not rows:
        die(f"no missions for {tilde(repo)}")
    recs = [Mission(r["id"]).read() for r in rows]  # newest first; running ones win
    recs = [x for x in recs if x["state"] == "running"] + [x for x in recs if x["state"] != "running"]
    old = next((x["coordinator"] for x in recs if (x.get("coordinator") or {}).get("address")), None)
    if a.action == "show":
        if not old:
            die(f"{tilde(repo)} has no coordinator recorded")
        emit(old, a.json, lambda c: f"{c['address']}: {c.get('agent')}" + (f"/{c['model']}" if c.get("model") else "")
             + f" on {c.get('machine')}")
        return
    if a.model and not a.agent:
        die("--model needs --agent")
    alive = False
    if old and old.get("address"):
        code, out, _ = hc(["get", old["address"], "--json"], timeout=20)
        try:
            t = json.loads(out) if code == 0 else {}
            alive = bool(t) and (t.get("terminal", t).get("state") or "live") not in DEAD_STATES
        except (json.JSONDecodeError, AttributeError):
            alive = False
    new = hand_over_coordinator(cfg, repo, old, a.reason or "replaced by request", alive=alive,
                                agent=a.agent, model=a.model, force=a.force)
    if not new:
        die("no agent available for a new coordinator", code=3)
    emit(new, a.json, lambda c: f"new coordinator {c['address']} ({c['agent']}) for {tilde(repo)}")


