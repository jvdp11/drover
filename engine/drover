def coordinator_tab(repo):
    """Per-project herdr.tab id: Herdr reuses a tab by id across spaces, so a shared id pulls coordinators into the wrong space."""
    repo = os.path.realpath(repo)
    return f"drover-coordinator-{slug(os.path.basename(repo), 16)}-{hashlib.sha1(repo.encode()).hexdigest()[:8]}"


def tilde(path):
    path = os.path.abspath(os.path.expanduser(path))
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + os.sep) else path


def git_facts(path):
    """Branch, origin URL and last commit time of a repo here, or {} if it isn't one."""
    def g(*args):
        p = subprocess.run(["git", "-C", path, *args], capture_output=True, text=True)
        return p.stdout.strip() if p.returncode == 0 else ""
    if not g("rev-parse", "--git-dir"):
        return {}
    last = g("log", "-1", "--format=%ct")
    return {"branch": g("branch", "--show-current") or None, "remote": g("remote", "get-url", "origin") or None,
            "last_commit": int(last) if last.isdigit() else None}


def scan_repos(cfg):
    """Git repos up to two levels under the scan roots (default ~/Work)."""
    found = []
    for root in cfg.get("project_roots") or ["~/Work"]:
        root = os.path.expanduser(root)
        for depth1 in sorted(os.listdir(root)) if os.path.isdir(root) else []:
            p1 = os.path.join(root, depth1)
            if depth1.startswith(".") or not os.path.isdir(p1):
                continue
            if os.path.exists(os.path.join(p1, ".git")):
                found.append(p1)
                continue
            for depth2 in sorted(os.listdir(p1)):
                p2 = os.path.join(p1, depth2)
                if not depth2.startswith(".") and os.path.exists(os.path.join(p2, ".git")):
                    found.append(p2)
    return found


def save_user_config(update):
    """Merge `update` into the user's own config file (not the defaults)."""
    try:
        with open(CONFIG) as f:
            user = json.load(f)
    except FileNotFoundError:
        user = {"version": 1}
    write_json(CONFIG, merged(user, update))


def project_list(cfg):
    known = cfg.get("projects") or {}
    by_path = {os.path.expanduser(v["path"]): k for k, v in known.items()}
    rows = []
    for name, v in known.items():
        path = os.path.expanduser(v["path"])
        rows.append({"name": name, "path": tilde(path), "known": True, "exists": os.path.isdir(path),
                     "opened": v.get("opened"), **git_facts(path)})
    for path in scan_repos(cfg):
        if path not in by_path:
            rows.append({"name": os.path.basename(path), "path": tilde(path), "known": False, "exists": True,
                         **git_facts(path)})
    rows.sort(key=lambda r: (not r["known"], -(r.get("opened") or 0), -(r.get("last_commit") or 0)))
    return rows


def unique_name(cfg, name):
    known = cfg.get("projects") or {}
    base, n = slug(name, 40), 2
    out = base
    while out in known:
        out, n = f"{base}-{n}", n + 1
    return out


def cmd_project(a, cfg):
    if a.action == "list":
        rows = project_list(cfg)
        emit({"projects": rows}, a.json, lambda d: "\n".join(
            f"  {'*' if r['known'] else ' '} {r['name']:<24} {r['path']}" for r in d["projects"]))
        return
    if a.action == "add":
        path = os.path.abspath(os.path.expanduser(a.target))
        if not os.path.isdir(path):
            die(f"no folder {path}")
        known = cfg.get("projects") or {}
        name = next((k for k, v in known.items() if os.path.expanduser(v["path"]) == path), None) \
            or unique_name(cfg, a.name or os.path.basename(path))
        save_user_config({"projects": {name: {"path": tilde(path), "opened": int(time.time())}}})
        emit({"name": name, "path": tilde(path), "abs": path}, a.json, lambda d: f"{d['name']}: {d['path']}")
        return
    if a.action == "new":
        name = slug(a.target, 40)
        parent = os.path.abspath(os.path.expanduser(a.dir))
        path = os.path.join(parent, name)
        if os.path.exists(path):
            die(f"{tilde(path)} already exists; use `drover project add {tilde(path)}`")
        os.makedirs(parent, exist_ok=True)
        if a.clone:
            r = subprocess.run(["git", "clone", "--quiet", a.clone, path], capture_output=True, text=True)
            if r.returncode != 0:
                die(f"git clone failed: {r.stderr.strip()}")
        else:
            os.makedirs(path)
            subprocess.run(["git", "init", "-q", "-b", "main", path], check=True)
            with open(os.path.join(path, "README.md"), "w") as f:
                f.write(f"# {a.target}\n")
            subprocess.run(["git", "-C", path, "add", "README.md"], check=True)
            subprocess.run(["git", "-C", path, "commit", "-q", "-m", "Start"], capture_output=True)
            if a.github != "none":
                r = subprocess.run(["gh", "repo", "create", name, f"--{a.github}", "--source", path, "--push"],
                                   capture_output=True, text=True)
                if r.returncode != 0:
                    print(f"drover: GitHub repo not made: {r.stderr.strip()}", file=sys.stderr)
        save_user_config({"projects": {name: {"path": tilde(path), "opened": int(time.time())}}})
        emit({"name": name, "path": tilde(path), "abs": path, **git_facts(path)}, a.json,
             lambda d: f"{d['name']}: {d['path']}")
        return
    if a.action == "open":
        rows = {r["name"]: r for r in project_list(cfg)}
        r = rows.get(a.target)
        if not r:
            die(f"no project {a.target!r}")
        save_user_config({"projects": {r["name"]: {"path": r["path"], "opened": int(time.time())}}})
        emit({**r, "abs": os.path.expanduser(r["path"])}, a.json, lambda d: d["abs"])
        return
    if a.action == "forget":
        try:
            with open(CONFIG) as f:
                user = json.load(f)
        except FileNotFoundError:
            user = {}
        (user.get("projects") or {}).pop(a.target, None)
        write_json(CONFIG, user)
        emit({"forgot": a.target}, a.json, lambda d: f"forgot {d['forgot']}")


